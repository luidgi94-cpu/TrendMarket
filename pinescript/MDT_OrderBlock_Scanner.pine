//@version=6
// ============================================================================
//  MDT ORDER BLOCK SCANNER
// ============================================================================
//  Regles issues du backtest sur 527 jours de XAUUSD (2 070 trades,
//  winrate 57.4%, ecart au temoin aleatoire +0.115 R, p = 0.0001) :
//
//   ORDER BLOCK   derniere bougie inverse avant l'impulsion
//   OB+           Order Block AVEC imbalance (le haut de l'OB n'est pas
//                 atteint par le bas de la 3e bougie)  -> qualite superieure
//   OB            Order Block sans imbalance           -> qualite ordinaire
//   ENTREE        retour dans l'OB + UNE confirmation parmi trois
//   STOP          bas de l'Order Block (invalidation de structure)
//   TP1           1.0 R -> ferme une partie, stop a l'equilibre
//   TP2           3.0 R
//
//  IMPORTANT : les Order Blocks sont detectes SANS AUCUN FILTRE et toujours
//  affiches. Les filtres de tendance et d'horaire ne s'appliquent qu'a la
//  prise de position, jamais a la detection des zones.
//
//  CLOISONNEMENT DES UNITES DE TEMPS :
//  Les zones DESSINEES sur le graphique proviennent exclusivement de
//  l'unite de temps affichee. Un Order Block M15 n'apparait donc jamais
//  sur un graphique M5. Les Order Blocks des autres unites sont uniquement
//  REPORTES DANS LE TABLEAU, avec leurs bornes de prix : le graphique
//  reste lisible, et l'on sait ou se situent les zones superieures.
//
//  Non-repeignant : signaux evalues sur bougie CLOTUREE, pivots lus avec
//  leur decalage de confirmation, appels multi-unites en lookahead_off.
// ============================================================================

indicator("MDT Order Block Scanner", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------- ENTREES --
gOB = "1. Detection des Order Blocks"
impBars  = input.int(5,    "Bougies d'impulsion", minval = 2,        group = gOB)
impATR   = input.float(0.8,"Taille mini de l'impulsion (x ATR)", step = 0.1, group = gOB,
     tooltip = "Baisser cette valeur = plus d'Order Blocks detectes.")
obLife   = input.int(60,   "Duree de vie d'un OB (bougies)",         group = gOB)
maxOB    = input.int(3,    "Zones dessinees par sens", minval = 1, maxval = 10, group = gOB,
     tooltip = "Seules les zones les plus PROCHES du prix sont dessinees. " +
               "Au-dela de 3 ou 4 par sens le graphique devient illisible.")
maxDist  = input.float(3.0,"Distance max au prix (%)", step = 0.5,   group = gOB,
     tooltip = "Une zone situee a 10% du prix n'a aucune utilite " +
               "operationnelle en scalping. 0 = pas de limite.")

gE = "2. Prise de position"
useTrend = input.bool(true,"Filtrer par la tendance H1",             group = gE)
htfTrend = input.timeframe("60", "Unite de tendance",                group = gE)
emaFast  = input.int(20,   "EMA rapide", minval = 2,                 group = gE)
emaSlow  = input.int(60,   "EMA lente",  minval = 5,                 group = gE)
minForce = input.float(0.6,"Force mini de la tendance", step = 0.1,  group = gE,
     tooltip = "Ecart entre les deux EMA divise par la volatilite. " +
               "Mesure la NETTETE de la tendance, pas sa direction. " +
               "0.6 est la valeur retenue au backtest.")
onlyPlus = input.bool(false, "N'entrer que sur les OB+ (avec imbalance)", group = gE)
useKZ    = input.bool(true, "Filtrer les heures",                    group = gE)
kzStart  = input.int(6,  "Debut (heure UTC)", minval = 0, maxval = 23, group = gE)
kzEnd    = input.int(20, "Fin (heure UTC)",   minval = 0, maxval = 23, group = gE)

gC = "3. Confirmations d'entree"
useWick   = input.bool(true, "Meche de rejet",                       group = gC)
useEngulf = input.bool(true, "Bougie englobante",                    group = gC)
useChoch  = input.bool(true, "Changement de structure (CHoCH)",      group = gC)
wickRatio = input.float(1.5, "Meche / corps mini", step = 0.1,       group = gC)

gR = "4. Risque"
bufATR = input.float(0.15, "Marge sous l'OB (x ATR)", step = 0.05,   group = gR)
tp1R   = input.float(1.0,  "TP1 (en R)", step = 0.1,                 group = gR)
tp2R   = input.float(3.0,  "TP2 (en R)", step = 0.1,                 group = gR)
beAfter= input.bool(true,  "Stop a l'equilibre apres TP1",           group = gR)

gV = "5. Affichage"
showOB    = input.bool(true, "Zones Order Block",                    group = gV)
showFVG   = input.bool(true, "Zones d'imbalance",                    group = gV)
showSimple= input.bool(true, "Afficher aussi les OB sans imbalance", group = gV)
showTrade = input.bool(true, "Entree / SL / TP sur le graphique",    group = gV)
showTable = input.bool(true, "Tableau",                              group = gV)
cBull = input.color(color.new(#089981, 78), "OB+ achat",             group = gV)
cBull2= input.color(color.new(#2962ff, 85), "OB achat simple",       group = gV)
cBear = input.color(color.new(#f23645, 78), "OB+ vente",             group = gV)
cBear2= input.color(color.new(#ff9800, 85), "OB vente simple",       group = gV)
cFvg  = input.color(color.new(#7e57c2, 82), "Imbalance",             group = gV)

// ------------------------------------------------------------- CONTEXTE ---
atr = ta.atr(200)

// Force de tendance : AMPLITUDE de l'ecart des EMA, pas seulement son signe.
// Le backtest montre une relation monotone entre cette amplitude et le
// resultat : de -0.085 R en tendance faible a +0.108 R en tendance forte.
trendExpr() =>
    ef = ta.ema(close, emaFast)
    es = ta.ema(close, emaSlow)
    sd = ta.stdev(close, 24)
    sp = ef - es
    [math.sign(sp), sd > 0 ? math.abs(sp) / sd : 0.0]

[htfDirRaw, htfForceRaw] = request.security(syminfo.tickerid, htfTrend,
     trendExpr(), lookahead = barmerge.lookahead_off)
htfDir   = na(htfDirRaw)   ? 0   : int(math.sign(htfDirRaw))
htfForce = na(htfForceRaw) ? 0.0 : htfForceRaw

inKZ      = not useKZ or (hour(time, "UTC") >= kzStart and hour(time, "UTC") < kzEnd)
trendOk   = not useTrend or (htfDir != 0 and htfForce >= minForce)
tradeBias = useTrend ? htfDir : 0

// ------------------------------------------- DETECTION DES ORDER BLOCKS ---
type OB
    float top
    float bot
    int   dir
    bool  plus      // true = avec imbalance (OB+), false = OB simple
    int   born
    int   obBar     // indice de la bougie SOURCE : identifie la zone de facon unique
    bool  used
    box   bx
    box   fx
    label lb

var array<OB> obs = array.new<OB>()

// Impulsion : mouvement net sur impBars bougies. AUCUN filtre de tendance
// ni d'horaire ici : une zone existe independamment du fait qu'on veuille
// la trader ou non.
mv      = close - open[impBars - 1]
dirImp  = mv > 0 ? 1 : mv < 0 ? -1 : 0
impulse = not na(atr) and atr > 0 and dirImp != 0
           and math.abs(mv) >= impATR * atr

// POINT CRUCIAL : un Order Block est la derniere bougie inverse precedant
// UN rallye. Il y en a donc UN par rallye, pas un par bougie.
//
// La condition d'impulsion ci-dessus est un ETAT : elle reste vraie pendant
// toute la duree du mouvement. L'utiliser telle quelle creait une nouvelle
// zone a chaque bougie du rallye, soit une dizaine de zones empilees pour
// un seul mouvement.
//
// On ne retient donc que le DECLENCHEMENT de l'impulsion, c'est-a-dire la
// bougie ou la condition devient vraie apres avoir ete fausse. Un rallye
// ne produit alors qu'une seule detection.
impulseStart = impulse and (not impulse[1] or dirImp != dirImp[1])

// L'Order Block est la derniere bougie INVERSE avant l'impulsion.
findOB(int dir) =>
    idx = -1
    for j = impBars to impBars + 10
        if j < bar_index and idx == -1
            isOpp = dir > 0 ? close[j] < open[j] : close[j] > open[j]
            if isOpp
                idx := j
    idx

// Imbalance ANCREE sur l'OB : le haut de l'Order Block ne doit pas etre
// atteint par le bas de la troisieme bougie.
hasImb(int obIdx, int dir) =>
    obIdx >= 2 ? (dir > 0 ? low[obIdx - 2] > high[obIdx]
                          : high[obIdx - 2] < low[obIdx]) : false

if barstate.isconfirmed and impulseStart
    obIdx = findOB(dirImp)
    if obIdx > 0
        isPlus = hasImb(obIdx, dirImp)
        if showSimple or isPlus
            t = math.max(math.max(open[obIdx], close[obIdx]), high[obIdx])
            b = math.min(math.min(open[obIdx], close[obIdx]), low[obIdx])
            srcBar = bar_index - obIdx
            // Deduplication sur l'INDICE de la bougie source, pas sur son
            // prix : deux bougies distinctes peuvent avoir le meme sommet,
            // et une meme bougie ne doit jamais produire deux zones.
            dup = false
            if array.size(obs) > 0
                for i = 0 to array.size(obs) - 1
                    if array.get(obs, i).obBar == srcBar
                        dup := true
            if not dup
                col = dirImp > 0 ? (isPlus ? cBull : cBull2)
                                 : (isPlus ? cBear : cBear2)
                // l'unite de temps figure sur l'etiquette : on voit d'un
                // coup d'oeil que la zone appartient au graphique courant
                txt = "OB" + (isPlus ? "+" : "") +
                     (dirImp > 0 ? " ACHAT " : " VENTE ") + timeframe.period
                nb = box.new(bar_index - obIdx, t, bar_index + obLife, b,
                     bgcolor = showOB ? col : na,
                     border_color = color.new(col, 30), xloc = xloc.bar_index)
                nf = box(na)
                if showFVG and isPlus
                    ft = dirImp > 0 ? low[obIdx - 2] : low[obIdx]
                    fb = dirImp > 0 ? high[obIdx]    : high[obIdx - 2]
                    nf := box.new(bar_index - obIdx + 2, math.max(ft, fb),
                         bar_index + obLife, math.min(ft, fb), bgcolor = cFvg,
                         border_color = color.new(cFvg, 40), xloc = xloc.bar_index)
                nl = label.new(bar_index + obLife, (t + b) / 2, txt,
                     xloc = xloc.bar_index, style = label.style_label_left,
                     color = color.new(col, 10), textcolor = color.white,
                     size = size.tiny)
                array.push(obs, OB.new(t, b, dirImp, isPlus, bar_index, srcBar,
                     false, nb, nf, nl))

// purge : zones traversees, expirees, ou trop eloignees du prix
if array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        o = array.get(obs, i)
        broken  = o.dir > 0 ? close < o.bot : close > o.top
        expired = bar_index - o.born > obLife
        dist    = math.abs(close - (o.top + o.bot) / 2) / close * 100.0
        tooFar  = maxDist > 0 and dist > maxDist
        if broken or expired or tooFar
            box.delete(o.bx), box.delete(o.fx), label.delete(o.lb)
            array.remove(obs, i)

    // On ne conserve que les zones les PLUS PROCHES du prix, par sens.
    // Une zone lointaine n'a aucune utilite en scalping : le prix ne
    // l'atteindra pas dans l'horizon de la position.
    for i = array.size(obs) - 1 to 0
        o = array.get(obs, i)
        d = math.abs(close - (o.top + o.bot) / 2)
        nearer = 0
        for j = 0 to array.size(obs) - 1
            if j != i
                e = array.get(obs, j)
                if e.dir == o.dir and math.abs(close - (e.top + e.bot) / 2) < d
                    nearer += 1
        if nearer >= maxOB
            box.delete(o.bx), box.delete(o.fx), label.delete(o.lb)
            array.remove(obs, i)

// --------------------------------------------------------- CONFIRMATIONS --
body = math.abs(close - open)
lowW = math.min(open, close) - low
upW  = high - math.max(open, close)

wickBull   = useWick   and body > 0 and lowW >= wickRatio * body and close > open
wickBear   = useWick   and body > 0 and upW  >= wickRatio * body and close < open
engBull    = useEngulf and close[1] < open[1] and close > open and close >= open[1] and open <= close[1]
engBear    = useEngulf and close[1] > open[1] and close < open and close <= open[1] and open >= close[1]

ph = ta.pivothigh(high, 2, 2)
pl = ta.pivotlow(low, 2, 2)
var float lastPH = na
var float lastPL = na
lastPH := not na(ph) ? ph : lastPH
lastPL := not na(pl) ? pl : lastPL
chochBull = useChoch and not na(lastPH) and close > lastPH
chochBear = useChoch and not na(lastPL) and close < lastPL

confBull = wickBull or engBull or chochBull
confBear = wickBear or engBear or chochBear
nameOf(bool w, bool e, bool c) => w ? "Meche de rejet" : e ? "Englobante" : c ? "CHoCH" : ""

// -------------------------------------------------------------- SIGNAUX ---
var float eEntry = na
var float eStop  = na
var float eTp1   = na
var float eTp2   = na
var float eRisk  = na
var int   eDir   = 0
var bool  eTp1Hit = false
var string eConf = ""
var string eKind = ""
var line lE = na, var line lS = na, var line lT1 = na, var line lT2 = na

newSignal = false
if barstate.isconfirmed and eDir == 0 and inKZ and trendOk and array.size(obs) > 0
    for i = 0 to array.size(obs) - 1
        o = array.get(obs, i)
        dirOk  = not useTrend or o.dir == tradeBias
        plusOk = not onlyPlus or o.plus
        inside = low <= o.top and high >= o.bot
        if not o.used and dirOk and plusOk and inside
            ok = o.dir > 0 ? confBull : confBear
            if ok
                eDir    := o.dir
                eEntry  := close
                eStop   := o.dir > 0 ? o.bot - bufATR * atr : o.top + bufATR * atr
                eRisk   := math.abs(eEntry - eStop)
                eTp1    := eEntry + o.dir * tp1R * eRisk
                eTp2    := eEntry + o.dir * tp2R * eRisk
                eTp1Hit := false
                eConf   := o.dir > 0 ? nameOf(wickBull, engBull, chochBull)
                                     : nameOf(wickBear, engBear, chochBear)
                eKind   := o.plus ? "OB+" : "OB"
                o.used  := true
                newSignal := true
                break

var string eStat = "EN ATTENTE"
if eDir != 0
    hitS = eDir > 0 ? low  <= eStop : high >= eStop
    hitT1= eDir > 0 ? high >= eTp1  : low  <= eTp1
    hitT2= eDir > 0 ? high >= eTp2  : low  <= eTp2
    if hitS
        eStat := eTp1Hit ? "SORTI A L'EQUILIBRE" : "STOP TOUCHE"
        eDir := 0
    else
        if hitT1 and not eTp1Hit
            eTp1Hit := true
            eStat := "TP1 PRIS"
            if beAfter
                eStop := eEntry
        if hitT2
            eStat := "TP2 ATTEINT"
            eDir := 0
        else if not eTp1Hit
            eStat := "EN COURS"

pnlR = eDir != 0 and not na(eRisk) and eRisk > 0
     ? (close - eEntry) * eDir / eRisk : na

if showTrade and newSignal
    line.delete(lE), line.delete(lS), line.delete(lT1), line.delete(lT2)
    lE  := line.new(bar_index, eEntry, bar_index + 60, eEntry, color = color.white, width = 2)
    lS  := line.new(bar_index, eStop,  bar_index + 60, eStop,  color = #f23645, width = 2)
    lT1 := line.new(bar_index, eTp1,   bar_index + 60, eTp1,   color = #ff9800, width = 1,
         style = line.style_dashed)
    lT2 := line.new(bar_index, eTp2,   bar_index + 60, eTp2,   color = #089981, width = 2)
    // L'etiquette est ancree sur la BOUGIE D'ENTREE, du meme cote que la
    // fleche : sous la bougie pour un achat, au-dessus pour une vente.
    // Elle etait auparavant posee sur le stop ou sur le second objectif,
    // donc a un a trois R de distance, loin du point d'entree.
    label.new(bar_index, eDir > 0 ? low : high,
         (eDir > 0 ? "ACHAT " : "VENTE ") + eKind + " | " + eConf +
         "\nEntree " + str.tostring(eEntry, format.mintick) +
         "   SL " + str.tostring(eStop, format.mintick) +
         "\nTP1 "    + str.tostring(eTp1, format.mintick) +
         "   TP2 " + str.tostring(eTp2, format.mintick),
         style = eDir > 0 ? label.style_label_up : label.style_label_down,
         color = eDir > 0 ? color.new(#089981, 10) : color.new(#f23645, 10),
         textcolor = color.white, size = size.small)

plotshape(newSignal and eDir > 0, "Achat", shape.triangleup, location.belowbar,
     #089981, size = size.small)
plotshape(newSignal and eDir < 0, "Vente", shape.triangledown, location.abovebar,
     #f23645, size = size.small)

// ----------------------------------------- SCAN DES OB PAR UNITE DE TEMPS --
// Renvoie, pour l'unite demandee : direction de tendance, dernier OB achat
// et dernier OB vente encore valides, avec leur qualite (imbalance ou non).
obScan() =>
    // Plusieurs Order Blocks sont memorises par sens, puis on retient
    // le PLUS PERTINENT : celui dont le prix est le plus proche du cours
    // actuel. C'est la seule zone que le prix peut atteindre a court
    // terme, donc la seule exploitable. A distance comparable, une zone
    // avec imbalance l'emporte sur une zone simple.
    var array<float> bT = array.new<float>()
    var array<float> bB = array.new<float>()
    var array<bool>  bP = array.new<bool>()
    var array<float> sT = array.new<float>()
    var array<float> sB = array.new<float>()
    var array<bool>  sP = array.new<bool>()

    var int lastBullBar = -1
    var int lastBearBar = -1

    a   = ta.atr(200)
    m   = close - open[impBars - 1]
    dd  = m > 0 ? 1 : m < 0 ? -1 : 0
    imp = not na(a) and a > 0 and dd != 0 and math.abs(m) >= impATR * a
    // Meme regle que sur le graphique : un rallye produit UN Order Block.
    // On ne retient que le declenchement de l'impulsion.
    impStart = imp and (not imp[1] or dd != dd[1])

    if impStart
        idx = -1
        for j = impBars to impBars + 10
            if j < bar_index and idx == -1
                if (dd > 0 ? close[j] < open[j] : close[j] > open[j])
                    idx := j
        if idx > 0
            srcBar = bar_index - idx
            already = dd > 0 ? srcBar == lastBullBar : srcBar == lastBearBar
            if not already
                t = math.max(math.max(open[idx], close[idx]), high[idx])
                b = math.min(math.min(open[idx], close[idx]), low[idx])
                p = idx >= 2 ? (dd > 0 ? low[idx - 2] > high[idx]
                                       : high[idx - 2] < low[idx]) : false
                if dd > 0
                    lastBullBar := srcBar
                    array.push(bT, t), array.push(bB, b), array.push(bP, p)
                    if array.size(bT) > 8
                        array.shift(bT), array.shift(bB), array.shift(bP)
                else
                    lastBearBar := srcBar
                    array.push(sT, t), array.push(sB, b), array.push(sP, p)
                    if array.size(sT) > 8
                        array.shift(sT), array.shift(sB), array.shift(sP)

    // invalidation : le prix a traverse la zone
    if array.size(bB) > 0
        for i = array.size(bB) - 1 to 0
            if close < array.get(bB, i)
                array.remove(bT, i), array.remove(bB, i), array.remove(bP, i)
    if array.size(sT) > 0
        for i = array.size(sT) - 1 to 0
            if close > array.get(sT, i)
                array.remove(sT, i), array.remove(sB, i), array.remove(sP, i)

    // selection de la zone la plus proche, a qualite egale privilegiee OB+
    bestBT = float(na), bestBB = float(na), bestBP = false
    bd = 1e20
    if array.size(bT) > 0
        for i = 0 to array.size(bT) - 1
            mid = (array.get(bT, i) + array.get(bB, i)) / 2
            d   = math.abs(close - mid) * (array.get(bP, i) ? 0.85 : 1.0)
            if d < bd
                bd := d
                bestBT := array.get(bT, i)
                bestBB := array.get(bB, i)
                bestBP := array.get(bP, i)
    bestST = float(na), bestSB = float(na), bestSP = false
    sd = 1e20
    if array.size(sT) > 0
        for i = 0 to array.size(sT) - 1
            mid = (array.get(sT, i) + array.get(sB, i)) / 2
            d   = math.abs(close - mid) * (array.get(sP, i) ? 0.85 : 1.0)
            if d < sd
                sd := d
                bestST := array.get(sT, i)
                bestSB := array.get(sB, i)
                bestSP := array.get(sP, i)

    ef = ta.ema(close, emaFast)
    es = ta.ema(close, emaSlow)
    td = ef > es ? 1 : ef < es ? -1 : 0
    [td, bestBT, bestBB, bestBP, bestST, bestSB, bestSP]

// Appels evalues a CHAQUE bougie, hors de tout bloc conditionnel.
[t5,  b5t,  b5b,  b5p,  s5t,  s5b,  s5p ] = request.security(syminfo.tickerid, "5",   obScan(), lookahead = barmerge.lookahead_off)
[t15, b15t, b15b, b15p, s15t, s15b, s15p] = request.security(syminfo.tickerid, "15",  obScan(), lookahead = barmerge.lookahead_off)
[t60, b60t, b60b, b60p, s60t, s60b, s60p] = request.security(syminfo.tickerid, "60",  obScan(), lookahead = barmerge.lookahead_off)
[t240,b240t,b240b,b240p,s240t,s240b,s240p]= request.security(syminfo.tickerid, "240", obScan(), lookahead = barmerge.lookahead_off)
[tD,  bDt,  bDb,  bDp,  sDt,  sDb,  sDp ] = request.security(syminfo.tickerid, "D",   obScan(), lookahead = barmerge.lookahead_off)

zone(float t, float b) =>
    na(t) or na(b) ? "—"
     : str.tostring(t, format.mintick) + "\n" + str.tostring(b, format.mintick) +
       "  (" + str.tostring(math.abs(close - (t + b) / 2) / close * 100, "#.00") + "%)"

// ------------------------------------------------------------- TABLEAU ----
var table tb = na
if showTable and barstate.islast
    table.delete(tb)
    tb := table.new(position.bottom_right, 6, 13, bgcolor = color.new(#131722, 5),
         border_width = 1, border_color = color.new(color.gray, 70),
         frame_width = 1, frame_color = color.new(#2962ff, 50))

    hdr = color.new(#1e222d, 0)
    table.cell(tb, 0, 0, "SCANNER MULTI-UNITES", text_color = #2962ff,
         text_size = size.normal, bgcolor = hdr)
    table.merge_cells(tb, 0, 0, 5, 0)

    table.cell(tb, 0, 1, "UT",        text_color = color.silver, text_size = size.small, bgcolor = hdr)
    table.cell(tb, 1, 1, "Tendance",  text_color = color.silver, text_size = size.small, bgcolor = hdr)
    table.cell(tb, 2, 1, "OB Achat",  text_color = #089981,      text_size = size.small, bgcolor = hdr)
    table.cell(tb, 3, 1, "Qual.",     text_color = color.silver, text_size = size.small, bgcolor = hdr)
    table.cell(tb, 4, 1, "OB Vente",  text_color = #f23645,      text_size = size.small, bgcolor = hdr)
    table.cell(tb, 5, 1, "Qual.",     text_color = color.silver, text_size = size.small, bgcolor = hdr)

    lbls = array.from("M5", "M15", "H1", "H4", "D")
    tds  = array.from(t5, t15, t60, t240, tD)
    bts  = array.from(b5t, b15t, b60t, b240t, bDt)
    bbs  = array.from(b5b, b15b, b60b, b240b, bDb)
    bps  = array.from(b5p, b15p, b60p, b240p, bDp)
    sts  = array.from(s5t, s15t, s60t, s240t, sDt)
    sbs  = array.from(s5b, s15b, s60b, s240b, sDb)
    sps  = array.from(s5p, s15p, s60p, s240p, sDp)

    for i = 0 to 4
        r  = i + 2
        td = array.get(tds, i)
        table.cell(tb, 0, r, array.get(lbls, i), text_color = color.white, text_size = size.small)
        table.cell(tb, 1, r, td > 0 ? "HAUSSIER ▲" : td < 0 ? "BAISSIER ▼" : "—",
             text_color = td > 0 ? #089981 : td < 0 ? #f23645 : color.gray, text_size = size.small)
        table.cell(tb, 2, r, zone(array.get(bts, i), array.get(bbs, i)),
             text_color = na(array.get(bts, i)) ? color.gray : #089981, text_size = size.tiny)
        table.cell(tb, 3, r, na(array.get(bts, i)) ? "" : (array.get(bps, i) ? "★ OB+" : "OB"),
             text_color = array.get(bps, i) ? color.yellow : color.silver, text_size = size.tiny)
        table.cell(tb, 4, r, zone(array.get(sts, i), array.get(sbs, i)),
             text_color = na(array.get(sts, i)) ? color.gray : #f23645, text_size = size.tiny)
        table.cell(tb, 5, r, na(array.get(sts, i)) ? "" : (array.get(sps, i) ? "★ OB+" : "OB"),
             text_color = array.get(sps, i) ? color.yellow : color.silver, text_size = size.tiny)

    // --- consensus des unites de temps ---
    sumT = (t5 > 0 ? 1 : t5 < 0 ? -1 : 0) + (t15 > 0 ? 1 : t15 < 0 ? -1 : 0) +
           (t60 > 0 ? 1 : t60 < 0 ? -1 : 0) + (t240 > 0 ? 1 : t240 < 0 ? -1 : 0) +
           (tD > 0 ? 1 : tD < 0 ? -1 : 0)
    table.cell(tb, 0, 7, "CONSENSUS", text_color = color.silver, text_size = size.small, bgcolor = hdr)
    table.cell(tb, 1, 7, sumT >= 2 ? "ACHAT" : sumT <= -2 ? "VENTE" : "NEUTRE",
         text_color = sumT >= 2 ? #089981 : sumT <= -2 ? #f23645 : color.gray,
         text_size = size.small, bgcolor = hdr)
    table.cell(tb, 2, 7, "Force H1 " + str.tostring(htfForce, "#.00"),
         text_color = htfForce >= minForce ? color.white : color.gray,
         text_size = size.tiny, bgcolor = hdr)
    table.cell(tb, 3, 7, htfForce >= minForce ? "NETTE" : "faible",
         text_color = htfForce >= minForce ? #089981 : color.gray,
         text_size = size.tiny, bgcolor = hdr)
    table.cell(tb, 4, 7, inKZ ? "SEANCE OK" : "HORS SEANCE",
         text_color = inKZ ? #089981 : color.gray, text_size = size.tiny, bgcolor = hdr)
    table.cell(tb, 5, 7, trendOk and inKZ ? "PRET" : "ATTENTE",
         text_color = trendOk and inKZ ? color.yellow : color.gray,
         text_size = size.tiny, bgcolor = hdr)

    // --- position en cours ---
    table.cell(tb, 0, 8, "POSITION", text_color = #2962ff, text_size = size.normal, bgcolor = hdr)
    table.merge_cells(tb, 0, 8, 5, 8)

    hasPos = eDir != 0
    table.cell(tb, 0, 9, "Sens",  text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 9, hasPos ? (eDir > 0 ? "ACHAT" : "VENTE") : "—",
         text_color = hasPos ? (eDir > 0 ? #089981 : #f23645) : color.gray, text_size = size.small)
    table.cell(tb, 2, 9, "Entree", text_color = color.silver, text_size = size.small)
    table.cell(tb, 3, 9, hasPos ? str.tostring(eEntry, format.mintick) : "—",
         text_color = color.white, text_size = size.small)
    table.cell(tb, 4, 9, "Type",  text_color = color.silver, text_size = size.small)
    table.cell(tb, 5, 9, hasPos ? eKind : "—", text_color = color.yellow, text_size = size.small)

    table.cell(tb, 0, 10, "SL",   text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 10, hasPos ? str.tostring(eStop, format.mintick) : "—",
         text_color = #f23645, text_size = size.small)
    table.cell(tb, 2, 10, "TP1",  text_color = color.silver, text_size = size.small)
    table.cell(tb, 3, 10, hasPos ? str.tostring(eTp1, format.mintick) : "—",
         text_color = #ff9800, text_size = size.small)
    table.cell(tb, 4, 10, "TP2",  text_color = color.silver, text_size = size.small)
    table.cell(tb, 5, 10, hasPos ? str.tostring(eTp2, format.mintick) : "—",
         text_color = #089981, text_size = size.small)

    table.cell(tb, 0, 11, "Statut", text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 11, eStat, text_color = color.yellow, text_size = size.small)
    table.merge_cells(tb, 1, 11, 2, 11)
    table.cell(tb, 3, 11, "PnL", text_color = color.silver, text_size = size.small)
    table.cell(tb, 4, 11, na(pnlR) ? "—" : str.tostring(pnlR, "#.00") + " R",
         text_color = na(pnlR) ? color.gray : pnlR >= 0 ? #089981 : #f23645,
         text_size = size.small)
    table.cell(tb, 5, 11, hasPos ? (eTp1Hit ? "TP1 ✓" : "") : "",
         text_color = #ff9800, text_size = size.small)

    // --- zones actives ---
    nB = 0, nS = 0
    if array.size(obs) > 0
        for i = 0 to array.size(obs) - 1
            o = array.get(obs, i)
            if o.dir > 0
                nB += 1
            else
                nS += 1
    table.cell(tb, 0, 12, "Zones actives", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 12, str.tostring(nB) + " achat", text_color = #089981, text_size = size.tiny)
    table.cell(tb, 2, 12, str.tostring(nS) + " vente", text_color = #f23645, text_size = size.tiny)
    table.cell(tb, 3, 12, "★ = avec imbalance", text_color = color.yellow, text_size = size.tiny)
    table.merge_cells(tb, 3, 12, 5, 12)

// -------------------------------------------------------------- ALERTES ---
alertcondition(newSignal and eDir > 0, "Signal ACHAT",
     "Order Block haussier confirme sur {{ticker}} {{interval}}")
alertcondition(newSignal and eDir < 0, "Signal VENTE",
     "Order Block baissier confirme sur {{ticker}} {{interval}}")
