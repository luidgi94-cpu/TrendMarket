//@version=6
// ============================================================================
//  ORDER BLOCK SCANNER  -  strategie validee sur 527 jours de XAUUSD
// ============================================================================
//  Regles issues du backtest (2 070 trades, winrate 57.4%, ecart au temoin
//  aleatoire +0.115 R, p = 0.0001) :
//
//   TENDANCE      EMA 20/60 en H1, filtre d'AMPLITUDE (pas seulement le signe)
//   ORDER BLOCK   derniere bougie inverse avant l'impulsion
//   IMBALANCE     le haut de l'OB n'est pas atteint par le bas de la 3e bougie
//   ENTREE        retour dans l'OB + UNE confirmation parmi trois
//   STOP          bas de l'Order Block (invalidation), jamais sous la meche
//   TP1           1.0 R -> ferme 33%, stop a l'equilibre
//   TP2           3.0 R
//
//  Non-repeignant : tous les signaux sont evalues sur bougie CLOTUREE.
// ============================================================================

indicator("MDT Order Block Scanner", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------- ENTREES --
gT = "Tendance"
htfTrend   = input.timeframe("60",  "Unite de tendance",           group = gT)
emaFast    = input.int(20,  "EMA rapide",   minval = 2,            group = gT)
emaSlow    = input.int(60,  "EMA lente",    minval = 5,            group = gT)
minForce   = input.float(0.6, "Force minimale de tendance", step = 0.1, group = gT,
     tooltip = "Ecart des EMA normalise par la volatilite. 0.6 est la valeur " +
               "retenue au backtest : au-dela le filtre devient trop restrictif " +
               "et fait perdre plus de trades qu'il n'en ameliore.")

gOB = "Order Block"
impBars    = input.int(5,   "Bougies d'impulsion",  minval = 2,    group = gOB)
impATR     = input.float(0.8, "Impulsion mini (x ATR)", step = 0.1, group = gOB)
needFVG    = input.bool(false, "Imbalance obligatoire",            group = gOB,
     tooltip = "Le haut de l'OB ne doit pas etre atteint par le bas de la " +
               "3e bougie. Exigence stricte : divise la frequence par cinq.")
obLife     = input.int(48,  "Duree de vie de l'OB (bougies)",      group = gOB)

gC = "Confirmation"
useWick    = input.bool(true, "Meche de rejet",                    group = gC)
useEngulf  = input.bool(true, "Bougie englobante",                 group = gC)
useChoch   = input.bool(true, "Changement de structure",           group = gC)
wickRatio  = input.float(1.5, "Meche / corps mini", step = 0.1,    group = gC)
confBars   = input.int(6,   "Fenetre de confirmation",             group = gC)

gR = "Risque"
bufATR     = input.float(0.15, "Marge sous l'OB (x ATR)", step = 0.05, group = gR)
tp1R       = input.float(1.0, "TP1 (en R)", step = 0.1,            group = gR)
tp2R       = input.float(3.0, "TP2 (en R)", step = 0.1,            group = gR)
part1      = input.float(33,  "% ferme au TP1", step = 1,          group = gR)
beAfter    = input.bool(true, "Stop a l'equilibre apres TP1",      group = gR)

gS = "Seance"
useKZ      = input.bool(true, "Filtrer les heures",                group = gS)
kzStart    = input.int(6,  "Debut (heure UTC)", minval = 0, maxval = 23, group = gS)
kzEnd      = input.int(20, "Fin (heure UTC)",   minval = 0, maxval = 23, group = gS)

gV = "Affichage"
showOB     = input.bool(true, "Zones Order Block",                 group = gV)
showFVG    = input.bool(true, "Zones d'imbalance",                 group = gV)
showTrade  = input.bool(true, "Entree / SL / TP",                  group = gV)
showTable  = input.bool(true, "Tableau multi-unites",              group = gV)
cBull      = input.color(color.new(#089981, 75), "OB haussier",    group = gV)
cBear      = input.color(color.new(#f23645, 75), "OB baissier",    group = gV)
cFvg       = input.color(color.new(#7e57c2, 80), "Imbalance",      group = gV)

// ------------------------------------------------------------- CONTEXTE ---
atr = ta.atr(288)

// Force de tendance : on mesure l'AMPLITUDE de l'ecart des EMA, pas son signe.
// Le backtest montre une relation monotone entre cette amplitude et le
// resultat : de -0.085 R en tendance faible a +0.108 R en tendance forte.
trendExpr() =>
    ef = ta.ema(close, emaFast)
    es = ta.ema(close, emaSlow)
    sd = ta.stdev(close, 24)
    sp = ef - es
    [math.sign(sp), sd > 0 ? math.abs(sp) / sd : 0.0]

[htfDir, htfForce] = request.security(syminfo.tickerid, htfTrend, trendExpr(),
     lookahead = barmerge.lookahead_off)

inKZ = not useKZ or (hour(time, "UTC") >= kzStart and hour(time, "UTC") < kzEnd)
bias = htfDir
strongEnough = htfForce >= minForce

// --------------------------------------------------------- ORDER BLOCKS ---
type OB
    float top
    float bot
    int   dir
    int   born
    bool  used
    box   bx
    box   fx
    label lb

var array<OB> obs = array.new<OB>()

// Impulsion : mouvement net sur impBars bougies, aligne sur la tendance H1
move      = close - open[impBars - 1]
impulseOk = not na(atr) and atr > 0 and math.sign(move) == bias
             and math.abs(move) >= impATR * atr and bias != 0

// L'Order Block est la derniere bougie INVERSE avant l'impulsion.
findOB(int dir) =>
    idx = -1
    for j = impBars to impBars + 10
        if j < bar_index
            isOpp = dir > 0 ? close[j] < open[j] : close[j] > open[j]
            if isOpp and idx == -1
                idx := j
    idx

// Imbalance ANCREE sur l'OB : entre la bougie OB et la 3e suivante,
// le haut de l'OB ne doit pas etre atteint par le bas de la 3e.
hasImbalance(int obIdx, int dir) =>
    ok = false
    if obIdx >= 2
        ok := dir > 0 ? low[obIdx - 2] > high[obIdx] : high[obIdx - 2] < low[obIdx]
    ok

if barstate.isconfirmed and impulseOk and inKZ and strongEnough
    obIdx = findOB(bias)
    if obIdx > 0
        okFvg = hasImbalance(obIdx, bias)
        if not needFVG or okFvg
            t = math.max(math.max(open[obIdx], close[obIdx]), high[obIdx])
            b = math.min(math.min(open[obIdx], close[obIdx]), low[obIdx])
            bxc = bias > 0 ? cBull : cBear
            nb = box.new(bar_index - obIdx, t, bar_index + obLife, b,
                 bgcolor = showOB ? bxc : na, border_color = color.new(bxc, 40),
                 xloc = xloc.bar_index)
            nf = box(na)
            if showFVG and okFvg
                ft = bias > 0 ? low[obIdx - 2] : low[obIdx]
                fb = bias > 0 ? high[obIdx]    : high[obIdx - 2]
                nf := box.new(bar_index - obIdx + 2, math.max(ft, fb),
                     bar_index + obLife, math.min(ft, fb),
                     bgcolor = cFvg, border_color = color.new(cFvg, 30),
                     xloc = xloc.bar_index)
            nl = label.new(bar_index + obLife, bias > 0 ? b : t,
                 bias > 0 ? "OB+" : "OB-", xloc = xloc.bar_index,
                 style = bias > 0 ? label.style_label_left : label.style_label_left,
                 color = color.new(bxc, 20), textcolor = color.white, size = size.tiny)
            array.push(obs, OB.new(t, b, bias, bar_index, false, nb, nf, nl))

// purge : OB expires ou traverses (invalides)
if array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        o = array.get(obs, i)
        broken = o.dir > 0 ? low < o.bot : high > o.top
        expired = bar_index - o.born > obLife
        if broken or expired
            box.delete(o.bx)
            box.delete(o.fx)
            label.delete(o.lb)
            array.remove(obs, i)

// ------------------------------------------------------- CONFIRMATIONS ---
body  = math.abs(close - open)
rng   = high - low
lowW  = math.min(open, close) - low
upW   = high - math.max(open, close)

wickBull   = useWick   and body > 0 and lowW >= wickRatio * body and close > open
wickBear   = useWick   and body > 0 and upW  >= wickRatio * body and close < open
engulfBull = useEngulf and close[1] < open[1] and close > open and close >= open[1] and open <= close[1]
engulfBear = useEngulf and close[1] > open[1] and close < open and close <= open[1] and open >= close[1]

// CHoCH : cloture au-dela du dernier pivot oppose CONFIRME (decale de 2).
ph = ta.pivothigh(high, 2, 2)
pl = ta.pivotlow(low, 2, 2)
var float lastPH = na
var float lastPL = na
lastPH := not na(ph) ? ph : lastPH
lastPL := not na(pl) ? pl : lastPL
chochBull = useChoch and not na(lastPH) and close > lastPH
chochBear = useChoch and not na(lastPL) and close < lastPL

confBull = wickBull or engulfBull or chochBull
confBear = wickBear or engulfBear or chochBear

confName(bool w, bool e, bool c) =>
    w ? "Meche" : e ? "Englobante" : c ? "CHoCH" : ""

// ------------------------------------------------------------- SIGNAUX ---
var float eEntry = na
var float eStop  = na
var float eTp1   = na
var float eTp2   = na
var int   eDir   = 0
var bool  eHitTp1 = false
var string eConf = ""
var line lEntry = na, var line lStop = na, var line lTp1 = na, var line lTp2 = na

inZone(OB o) => low <= o.top and high >= o.bot

newSignal = false
if barstate.isconfirmed and eDir == 0 and inKZ and strongEnough and array.size(obs) > 0
    for i = 0 to array.size(obs) - 1
        o = array.get(obs, i)
        if not o.used and o.dir == bias and inZone(o)
            ok = bias > 0 ? confBull : confBear
            if ok
                eDir   := bias
                eEntry := close
                eStop  := bias > 0 ? o.bot - bufATR * atr : o.top + bufATR * atr
                r      = math.abs(eEntry - eStop)
                eTp1   := eEntry + bias * tp1R * r
                eTp2   := eEntry + bias * tp2R * r
                eHitTp1 := false
                eConf  := bias > 0 ? confName(wickBull, engulfBull, chochBull)
                                   : confName(wickBear, engulfBear, chochBear)
                o.used := true
                newSignal := true
                break

// suivi de la position
if eDir != 0
    hitStop = eDir > 0 ? low <= eStop : high >= eStop
    hitTp1  = eDir > 0 ? high >= eTp1 : low  <= eTp1
    hitTp2  = eDir > 0 ? high >= eTp2 : low  <= eTp2
    if hitStop
        eDir := 0
    else
        if hitTp1 and not eHitTp1
            eHitTp1 := true
            if beAfter
                eStop := eEntry
        if hitTp2
            eDir := 0

// trace du scenario une fois VALIDE par le marche
if showTrade and newSignal
    line.delete(lEntry), line.delete(lStop), line.delete(lTp1), line.delete(lTp2)
    lEntry := line.new(bar_index, eEntry, bar_index + 40, eEntry,
         color = color.white, width = 2, style = line.style_solid)
    lStop  := line.new(bar_index, eStop,  bar_index + 40, eStop,
         color = color.red, width = 2)
    lTp1   := line.new(bar_index, eTp1,   bar_index + 40, eTp1,
         color = color.orange, width = 1, style = line.style_dashed)
    lTp2   := line.new(bar_index, eTp2,   bar_index + 40, eTp2,
         color = color.lime, width = 2)
    label.new(bar_index, eDir > 0 ? eStop : eTp2,
         (eDir > 0 ? "ACHAT " : "VENTE ") + str.tostring(eEntry, format.mintick) +
         "\nSL " + str.tostring(eStop, format.mintick) +
         "\nTP1 " + str.tostring(eTp1, format.mintick) +
         "\nTP2 " + str.tostring(eTp2, format.mintick) +
         "\n" + eConf,
         style = eDir > 0 ? label.style_label_up : label.style_label_down,
         color = eDir > 0 ? color.new(#089981, 15) : color.new(#f23645, 15),
         textcolor = color.white, size = size.small)

plotshape(newSignal and eDir > 0, "Achat", shape.triangleup,
     location.belowbar, color.new(#089981, 0), size = size.small)
plotshape(newSignal and eDir < 0, "Vente", shape.triangledown,
     location.abovebar, color.new(#f23645, 0), size = size.small)

// ---------------------------------------------------- TABLEAU MULTI-UT ---
scan(string tf) =>
    [d, f] = request.security(syminfo.tickerid, tf, trendExpr(),
         lookahead = barmerge.lookahead_off)
    [d, f]

var table tb = na
if showTable and barstate.islast
    table.delete(tb)
    tb := table.new(position.bottom_right, 4, 7,
         bgcolor = color.new(#131722, 10), border_width = 1,
         border_color = color.new(color.gray, 60), frame_width = 1,
         frame_color = color.new(color.gray, 40))
    table.cell(tb, 0, 0, "UT",      text_color = color.silver, text_size = size.small)
    table.cell(tb, 1, 0, "Tendance",text_color = color.silver, text_size = size.small)
    table.cell(tb, 2, 0, "Force",   text_color = color.silver, text_size = size.small)
    table.cell(tb, 3, 0, "Valide",  text_color = color.silver, text_size = size.small)

    tfs = array.from("5", "15", "60", "240", "D")
    lbl = array.from("M5", "M15", "H1", "H4", "D")
    for i = 0 to array.size(tfs) - 1
        [d, f] = scan(array.get(tfs, i))
        up = d > 0
        table.cell(tb, 0, i + 1, array.get(lbl, i),
             text_color = color.white, text_size = size.small)
        table.cell(tb, 1, i + 1, up ? "HAUSSE" : d < 0 ? "BAISSE" : "-",
             text_color = up ? #089981 : d < 0 ? #f23645 : color.gray,
             text_size = size.small)
        table.cell(tb, 2, i + 1, str.tostring(f, "#.00"),
             text_color = f >= minForce ? color.white : color.gray,
             text_size = size.small)
        table.cell(tb, 3, i + 1, f >= minForce ? "OUI" : "non",
             text_color = f >= minForce ? #089981 : color.gray,
             text_size = size.small)

    st = eDir != 0 ? (eDir > 0 ? "ACHAT EN COURS" : "VENTE EN COURS")
         : array.size(obs) > 0 ? "ZONES ACTIVES : " + str.tostring(array.size(obs))
         : "AUCUNE ZONE"
    table.cell(tb, 0, 6, st, text_color = color.yellow, text_size = size.small)
    table.cell(tb, 1, 6, eDir != 0 ? str.tostring(eEntry, format.mintick) : "-",
         text_color = color.white, text_size = size.small)
    table.cell(tb, 2, 6, eDir != 0 ? "SL " + str.tostring(eStop, format.mintick) : "-",
         text_color = color.red, text_size = size.small)
    table.cell(tb, 3, 6, eHitTp1 ? "TP1 pris" : "-",
         text_color = color.orange, text_size = size.small)

// -------------------------------------------------------------- ALERTES --
alertcondition(newSignal and eDir > 0, "Signal ACHAT",
     "Order Block haussier confirme sur {{ticker}} {{interval}}")
alertcondition(newSignal and eDir < 0, "Signal VENTE",
     "Order Block baissier confirme sur {{ticker}} {{interval}}")
