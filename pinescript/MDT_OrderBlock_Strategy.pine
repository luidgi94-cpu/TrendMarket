//@version=6
// ============================================================================
//  MDT ORDER BLOCK  -  STRATEGIE  (pour le Strategy Tester de TradingView)
// ============================================================================
//  Transcription exacte des regles validees sur 527 jours de XAUUSD reel
//  (donnees MetaTrader 5 du broker de l'utilisateur, janvier 2025 a
//  septembre 2026) :
//
//    2 070 trades  |  3.93 par jour  |  winrate 57.4%
//    esperance +0.178 R  |  temoin par permutation +0.063 R
//    ecart net +0.115 R  |  p = 0.0001
//
//  Trois comparaisons de detection ont ete conduites sur ces memes donnees,
//  chacune contre un temoin construit en melangeant les bougies a
//  l'interieur de chaque heure :
//
//    fenetre fixe + meches   2 070 trades, 57.4%, +0.124 R, p = 0.0001
//    fenetre fixe + corps    1 629 trades, 55.1%, +0.110 R, p = 0.0014
//    remontee + corps          672 trades, 53.7%, +0.075 R, p = 0.16
//
//  C'est la premiere qui est implantee ici.
//
//  REGLES
//    OB        derniere bougie inverse trouvee entre impBars et impBars+10
//              bougies en arriere, prise MECHES COMPRISES
//    IMPULSION mouvement net sur impBars bougies >= 0.8 x ATR(200)
//    TENDANCE  EMA 20/60 en H1, filtre d'AMPLITUDE >= 0.6
//    ENTREE    retour dans l'OB + UNE confirmation parmi trois
//    STOP      extremite de l'Order Block + 0.15 ATR
//    TP1       1.0 R -> ferme 33%, stop remonte a l'equilibre
//    TP2       3.0 R
//
//  Non-repeignant : toutes les decisions sont prises sur bougie CLOTUREE,
//  les pivots sont lus avec leur decalage de confirmation, et les appels
//  multi-unites utilisent lookahead_off.
//
//  A UTILISER EN M5 : c'est la periodicite sur laquelle les regles ont ete
//  validees. En M15 ou H1 les seuils ne correspondent plus.
// ============================================================================

strategy("MDT Order Block Strategy", overlay = true,
     initial_capital = 450,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.165,
     slippage = 10,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     max_boxes_count = 500, max_labels_count = 200)

// ---------------------------------------------------------------- ENTREES --
gOB = "1. Order Block"
impBars = input.int(5,    "Fenetre d'impulsion (bougies)", minval = 2, group = gOB)
impATR  = input.float(0.8,"Taille mini de l'impulsion (x ATR)", step = 0.1, group = gOB)
obLife  = input.int(48,   "Duree de vie d'un OB (bougies)", group = gOB)

gE = "2. Filtres d'entree"
useTrend = input.bool(true, "Filtrer par la tendance H1",            group = gE)
htfTrend = input.timeframe("60", "Unite de tendance",                group = gE)
emaFast  = input.int(20,   "EMA rapide", minval = 2,                 group = gE)
emaSlow  = input.int(60,   "EMA lente",  minval = 5,                 group = gE)
minForce = input.float(0.6,"Force mini de la tendance", step = 0.1,  group = gE)
useKZ    = input.bool(true, "Filtrer les heures",                    group = gE)
kzStart  = input.int(6,  "Debut (heure UTC)", minval = 0, maxval = 23, group = gE)
kzEnd    = input.int(20, "Fin (heure UTC)",   minval = 0, maxval = 23, group = gE)
maxDay   = input.int(10, "Trades max par jour", minval = 1,          group = gE)

gC = "3. Confirmations"
useWick   = input.bool(true, "Meche de rejet",                       group = gC)
useEngulf = input.bool(true, "Bougie englobante",                    group = gC)
useChoch  = input.bool(true, "Changement de structure (CHoCH)",      group = gC)
wickRatio = input.float(1.5, "Meche / corps mini", step = 0.1,       group = gC)

gR = "4. Risque"
bufATR  = input.float(0.15, "Marge au-dela de l'OB (x ATR)", step = 0.05, group = gR)
tp1R    = input.float(1.0,  "TP1 (en R)", step = 0.1,                group = gR)
tp2R    = input.float(3.0,  "TP2 (en R)", step = 0.1,                group = gR)
part1   = input.int(33,     "% ferme au TP1", minval = 1, maxval = 99, group = gR)
beAfter = input.bool(true,  "Stop a l'equilibre apres TP1",          group = gR)
maxHold = input.int(48,     "Duree max d'une position (bougies)",    group = gR)

gV = "5. Affichage"
showOB = input.bool(true, "Dessiner les zones", group = gV)

// ------------------------------------------------------------- CONTEXTE ---
atr = ta.atr(200)

trendExpr() =>
    ef = ta.ema(close, emaFast)
    es = ta.ema(close, emaSlow)
    sd = ta.stdev(close, 24)
    sp = ef - es
    [math.sign(sp), sd > 0 ? math.abs(sp) / sd : 0.0]

[hd, hf] = request.security(syminfo.tickerid, htfTrend, trendExpr(),
     lookahead = barmerge.lookahead_off)
htfDir   = na(hd) ? 0   : int(math.sign(hd))
htfForce = na(hf) ? 0.0 : hf

inKZ    = not useKZ or (hour(time, "UTC") >= kzStart and hour(time, "UTC") < kzEnd)
trendOk = not useTrend or (htfDir != 0 and htfForce >= minForce)
bias    = useTrend ? htfDir : 0

var int tradesToday = 0
if ta.change(time("D")) != 0
    tradesToday := 0

// --------------------------------------------------------- ORDER BLOCKS ---
type OB
    float top
    float bot
    int   dir
    int   born
    int   obBar
    bool  used
    box   bx

var array<OB> obs = array.new<OB>()

mv      = close - open[impBars - 1]
dirImp  = mv > 0 ? 1 : mv < 0 ? -1 : 0
impulse = not na(atr) and atr > 0 and dirImp != 0
           and math.abs(mv) >= impATR * atr

// L'Order Block est la derniere bougie inverse trouvee dans la fenetre
// situee entre impBars et impBars + 10 bougies en arriere. Zone prise
// MECHES COMPRISES : c'est la variante qui a produit le meilleur resultat.
findOB(int dir) =>
    idx = -1
    for j = impBars to impBars + 10
        if idx == -1 and j < bar_index
            isOpp = dir > 0 ? close[j] < open[j] : close[j] > open[j]
            if isOpp
                idx := j
    idx

if barstate.isconfirmed and impulse
    obIdx = findOB(dirImp)
    if obIdx > 0
        t = math.max(math.max(open[obIdx], close[obIdx]), high[obIdx])
        b = math.min(math.min(open[obIdx], close[obIdx]), low[obIdx])
        srcBar = bar_index - obIdx
        dup = false
        if array.size(obs) > 0
            for i = 0 to array.size(obs) - 1
                if array.get(obs, i).obBar == srcBar
                    dup := true
        if not dup
            col = dirImp > 0 ? color.new(#089981, 82) : color.new(#f23645, 82)
            bx = showOB ? box.new(bar_index - obIdx, t, bar_index + obLife, b,
                 bgcolor = col, border_color = color.new(col, 40),
                 xloc = xloc.bar_index) : box(na)
            array.push(obs, OB.new(t, b, dirImp, bar_index, srcBar, false, bx))

if array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        o = array.get(obs, i)
        broken  = o.dir > 0 ? close < o.bot : close > o.top
        expired = bar_index - o.born > obLife
        if broken or expired
            box.delete(o.bx)
            array.remove(obs, i)

// --------------------------------------------------------- CONFIRMATIONS --
body = math.abs(close - open)
lowW = math.min(open, close) - low
upW  = high - math.max(open, close)

wickBull = useWick   and body > 0 and lowW >= wickRatio * body and close > open
wickBear = useWick   and body > 0 and upW  >= wickRatio * body and close < open
engBull  = useEngulf and close[1] < open[1] and close > open and close >= open[1] and open <= close[1]
engBear  = useEngulf and close[1] > open[1] and close < open and close <= open[1] and open >= close[1]

ph = ta.pivothigh(high, 2, 2)
pl = ta.pivotlow(low, 2, 2)
var float lastPH = na
var float lastPL = na
lastPH := not na(ph) ? ph : lastPH
lastPL := not na(pl) ? pl : lastPL
chochBull = useChoch and not na(lastPH) and close > lastPH
chochBear = useChoch and not na(lastPL) and close < lastPL

confBull = wickBull or engBull or chochBull
confBear = wickBear or engBear or chochBear

// -------------------------------------------------------------- SIGNAUX ---
var float eStop = na
var float eTp1  = na
var float eTp2  = na
var float eBE   = na
var bool  tp1Done = false
var int   entryBar = na

flat = strategy.position_size == 0

if barstate.isconfirmed and flat and inKZ and trendOk
     and tradesToday < maxDay and array.size(obs) > 0
    for i = 0 to array.size(obs) - 1
        o = array.get(obs, i)
        dirOk  = not useTrend or o.dir == bias
        inside = low <= o.top and high >= o.bot
        if not o.used and dirOk and inside
            ok = o.dir > 0 ? confBull : confBear
            if ok
                sp   = o.dir > 0 ? o.bot - bufATR * atr : o.top + bufATR * atr
                risk = math.abs(close - sp)
                if risk > 0
                    eStop := sp
                    eTp1  := close + o.dir * tp1R * risk
                    eTp2  := close + o.dir * tp2R * risk
                    eBE   := close
                    tp1Done := false
                    entryBar := bar_index
                    o.used := true
                    tradesToday += 1
                    if o.dir > 0
                        strategy.entry("L", strategy.long)
                    else
                        strategy.entry("S", strategy.short)
                    break

// ------------------------------------------------------------- GESTION ---
if strategy.position_size != 0 and not na(eStop)
    isLong = strategy.position_size > 0
    // TP1 partiel puis remontee du stop a l'equilibre
    if not tp1Done
        strategy.exit(isLong ? "X1L" : "X1S", from_entry = isLong ? "L" : "S",
             qty_percent = part1, limit = eTp1, stop = eStop)
        hit1 = isLong ? high >= eTp1 : low <= eTp1
        if hit1
            tp1Done := true
            if beAfter
                eStop := eBE
    else
        strategy.exit(isLong ? "X2L" : "X2S", from_entry = isLong ? "L" : "S",
             limit = eTp2, stop = eStop)
    // sortie au temps, comme dans le backtest Python
    if not na(entryBar) and bar_index - entryBar >= maxHold
        strategy.close_all("duree max")

// -------------------------------------------------------------- REPERES ---
plotshape(strategy.position_size > 0 and strategy.position_size[1] == 0,
     "Achat", shape.triangleup, location.belowbar, #089981, size = size.tiny)
plotshape(strategy.position_size < 0 and strategy.position_size[1] == 0,
     "Vente", shape.triangledown, location.abovebar, #f23645, size = size.tiny)
