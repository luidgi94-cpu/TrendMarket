//@version=6
// ============================================================================
//  MDT ORDER BLOCK  -  STRATEGIE (Strategy Tester TradingView)
// ============================================================================
//  Transcription des regles validees sur 527 jours de XAUUSD reel
//  (export MetaTrader 5 du broker, janvier 2025 - septembre 2026) :
//
//    2 070 trades | 3.93 par jour | winrate 57.4%
//    esperance +0.178 R | temoin par permutation +0.063 R
//    ecart net +0.115 R | p = 0.0001
//
//  REGLES
//    OB        derniere bougie inverse entre impBars et impBars+10 bougies
//              en arriere, MECHES COMPRISES
//    IMPULSION mouvement net sur impBars bougies >= 0.8 x ATR(200)
//    TENDANCE  EMA 20/60 en H1, filtre d'AMPLITUDE >= 0.6
//    ENTREE    retour dans l'OB + UNE confirmation parmi trois
//    STOP      extremite de l'Order Block + 0.15 ATR
//    TP1       1.0 R -> ferme 33%, stop a l'equilibre
//    TP2       3.0 R
//
//  A UTILISER EN M5.
// ============================================================================

strategy("MDT Order Block Strategy", overlay = true,
     initial_capital       = 450,
     default_qty_type      = strategy.fixed,
     default_qty_value     = 1,
     commission_type       = strategy.commission.cash_per_contract,
     commission_value      = 0.165,
     slippage              = 10,
     pyramiding            = 0,
     calc_on_every_tick    = false,
     process_orders_on_close = true,
     max_bars_back         = 500,
     max_boxes_count       = 500,
     max_labels_count      = 100)

// ---------------------------------------------------------------- ENTREES --
gOB = "1. Order Block"
impBars = input.int(5,    "Fenetre d'impulsion (bougies)", minval = 2, maxval = 20, group = gOB)
impATR  = input.float(0.8,"Taille mini de l'impulsion (x ATR)", step = 0.1, group = gOB)
useBody = input.bool(false, "Zone = corps seul (sans meches)", group = gOB)
obLife  = input.int(48,   "Duree de vie d'un OB (bougies)", minval = 5, group = gOB)
keepOB  = input.int(25,   "Zones en memoire par sens", minval = 5, maxval = 60, group = gOB)

gE = "2. Filtres d'entree"
useTrend = input.bool(true, "Filtrer par la tendance H1",            group = gE)
htfTrend = input.timeframe("60", "Unite de tendance",                group = gE)
emaFast  = input.int(20,   "EMA rapide", minval = 2,                 group = gE)
emaSlow  = input.int(60,   "EMA lente",  minval = 5,                 group = gE)
minForce = input.float(0.6,"Force mini de la tendance", step = 0.1,  group = gE)
useKZ    = input.bool(true, "Filtrer les heures",                    group = gE)
// Le backtest applique sa plage sur l'heure SERVEUR du courtier, qui est
// en UTC+3 (confirme par le pic de volatilite a 15h30 serveur, soit la
// publication macro americaine de 12h30 UTC). Sa plage 6h-20h serveur
// vaut donc 3h-17h en vrai UTC, et c'est cette plage qu'il faut utiliser
// ici puisque hour(time, "UTC") renvoie du vrai UTC.
// Au passage, cela exclut 23h serveur, l'heure de rollover ou le spread
// double : 10% des minutes y depassent 0.30 USD contre 0.1% en seance.
kzStart  = input.int(3,  "Debut (heure UTC)", minval = 0, maxval = 23, group = gE)
kzEnd    = input.int(17, "Fin (heure UTC)",   minval = 0, maxval = 23, group = gE)
maxDay   = input.int(10, "Trades max par jour", minval = 1,          group = gE)

gC = "3. Confirmations"
useWick   = input.bool(true, "Meche de rejet",                       group = gC)
useEngulf = input.bool(true, "Bougie englobante",                    group = gC)
useChoch  = input.bool(true, "Changement de structure (CHoCH)",      group = gC)
wickRatio = input.float(1.5, "Meche / corps mini", step = 0.1,       group = gC)

gR = "4. Risque"
bufATR  = input.float(0.15, "Marge au-dela de l'OB (x ATR)", step = 0.05, group = gR)
tp1R    = input.float(1.0,  "TP1 (en R)", step = 0.1,                group = gR)
tp2R    = input.float(3.0,  "TP2 (en R)", step = 0.1,                group = gR)
part1   = input.int(33,     "% ferme au TP1", minval = 1, maxval = 99, group = gR)
beAfter = input.bool(true,  "Stop a l'equilibre apres TP1",          group = gR)
maxHold = input.int(48,     "Duree max d'une position (bougies)", minval = 5, group = gR)

gS = "5. Taille de position"
sizeMode = input.string("Risque %", "Mode", options = ["Risque %", "Lot fixe"], group = gS)
riskPct  = input.float(1.0, "Risque par trade (% du capital)", step = 0.25, group = gS)
fixQty   = input.float(1.0, "Quantite fixe (unites)", step = 0.01,   group = gS)

gV = "6. Affichage"
showOB  = input.bool(true, "Dessiner les zones",    group = gV)
maxDraw = input.int(3, "Zones dessinees par sens", minval = 1, maxval = 10, group = gV)

INVIS = color.new(color.black, 100)

// ------------------------------------------------------------- CONTEXTE ---
atr = ta.atr(200)

trendExpr() =>
    ef = ta.ema(close, emaFast)
    es = ta.ema(close, emaSlow)
    sd = ta.stdev(close, 24)
    sp = ef - es
    [math.sign(sp), sd > 0 ? math.abs(sp) / sd : 0.0]

[hdRaw, hfRaw] = request.security(syminfo.tickerid, htfTrend, trendExpr(),
     lookahead = barmerge.lookahead_off)
htfDir   = na(hdRaw) ? 0   : int(math.sign(hdRaw))
htfForce = na(hfRaw) ? 0.0 : hfRaw

inKZ    = not useKZ or (hour(time, "UTC") >= kzStart and hour(time, "UTC") < kzEnd)
trendOk = not useTrend or (htfDir != 0 and htfForce >= minForce)
bias    = useTrend ? htfDir : 0

var int tradesToday = 0
if ta.change(time("D")) != 0
    tradesToday := 0

// --------------------------------------------------------- ORDER BLOCKS ---
type OB
    float top
    float bot
    int   dir
    int   born
    int   obBar
    bool  used
    color col
    box   bx

var array<OB> obs = array.new<OB>()

mv      = close - open[impBars - 1]
dirImp  = mv > 0 ? 1 : mv < 0 ? -1 : 0
impulse = not na(atr) and atr > 0 and dirImp != 0
           and math.abs(mv) >= impATR * atr

findOB(int dir) =>
    idx = -1
    for j = impBars to impBars + 10
        if idx == -1 and j < bar_index
            isOpp = dir > 0 ? close[j] < open[j] : close[j] > open[j]
            if isOpp
                idx := j
    idx

if barstate.isconfirmed and impulse
    obIdx = findOB(dirImp)
    if obIdx > 0
        srcBar = bar_index - obIdx
        dup = false
        if array.size(obs) > 0
            for i = 0 to array.size(obs) - 1
                if array.get(obs, i).obBar == srcBar
                    dup := true
        if not dup
            float t = na
            float b = na
            if useBody
                t := math.max(open[obIdx], close[obIdx])
                b := math.min(open[obIdx], close[obIdx])
            else
                t := math.max(math.max(open[obIdx], close[obIdx]), high[obIdx])
                b := math.min(math.min(open[obIdx], close[obIdx]), low[obIdx])
            col = dirImp > 0 ? color.new(#089981, 82) : color.new(#f23645, 82)
            nb = box.new(bar_index - obIdx, t, bar_index + 3, b,
                 bgcolor = INVIS, border_color = INVIS, xloc = xloc.bar_index)
            array.push(obs, OB.new(t, b, dirImp, bar_index, srcBar, false, col, nb))

// --- invalidation : une CLOTURE au-dela de la zone ------------------------
if array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        if i < array.size(obs)
            o = array.get(obs, i)
            broken  = o.dir > 0 ? close < o.bot : close > o.top
            expired = bar_index - o.born > obLife
            if broken or expired
                box.delete(o.bx)
                array.remove(obs, i)

// --- bornage de la memoire, par sens --------------------------------------
if array.size(obs) > 0
    int nb1 = 0
    int ns1 = 0
    for i = array.size(obs) - 1 to 0
        if i < array.size(obs)
            o = array.get(obs, i)
            drop = false
            if o.dir > 0
                nb1 += 1
                drop := nb1 > keepOB
            else
                ns1 += 1
                drop := ns1 > keepOB
            if drop
                box.delete(o.bx)
                array.remove(obs, i)

// --- prolongation et visibilite -------------------------------------------
if array.size(obs) > 0
    for i = 0 to array.size(obs) - 1
        o = array.get(obs, i)
        box.set_right(o.bx, bar_index + 3)
        d = math.abs(close - (o.top + o.bot) / 2)
        nearer = 0
        for j = 0 to array.size(obs) - 1
            if j != i
                e = array.get(obs, j)
                if e.dir == o.dir and math.abs(close - (e.top + e.bot) / 2) < d
                    nearer += 1
        vis = showOB and nearer < maxDraw
        box.set_bgcolor(o.bx, vis ? o.col : INVIS)
        box.set_border_color(o.bx, vis ? color.new(o.col, 35) : INVIS)

// --------------------------------------------------------- CONFIRMATIONS --
body = math.abs(close - open)
lowW = math.min(open, close) - low
upW  = high - math.max(open, close)

wickBull = useWick   and body > 0 and lowW >= wickRatio * body and close > open
wickBear = useWick   and body > 0 and upW  >= wickRatio * body and close < open
engBull  = useEngulf and close[1] < open[1] and close > open and close >= open[1] and open <= close[1]
engBear  = useEngulf and close[1] > open[1] and close < open and close <= open[1] and open >= close[1]

ph = ta.pivothigh(high, 2, 2)
pl = ta.pivotlow(low, 2, 2)
var float lastPH = na
var float lastPL = na
lastPH := not na(ph) ? ph : lastPH
lastPL := not na(pl) ? pl : lastPL
chochBull = useChoch and not na(lastPH) and close > lastPH
chochBear = useChoch and not na(lastPL) and close < lastPL

confBull = wickBull or engBull or chochBull
confBear = wickBear or engBear or chochBear

// -------------------------------------------------------------- SIGNAUX ---
var float eStop   = na
var float eTp1    = na
var float eTp2    = na
var float eBE     = na
var bool  tp1Done = false
var int   entryBar = na
var int   eDir    = 0

flat = strategy.position_size == 0 and strategy.opentrades == 0

// Le signal doit etre calcule AVANT la gestion, pour que les ordres de
// protection soient poses sur la bougie d'entree elle-meme (comme dans le
// backtest Python, ou le stop est teste des la bougie de prise de position).
newSignal = false
if barstate.isconfirmed and flat and inKZ and trendOk
     and tradesToday < maxDay and array.size(obs) > 0 and not na(atr)
    for i = 0 to array.size(obs) - 1
        o = array.get(obs, i)
        dirOk  = not useTrend or o.dir == bias
        inside = low <= o.top and high >= o.bot
        if not o.used and dirOk and inside and not newSignal
            ok = o.dir > 0 ? confBull : confBear
            if ok
                sp = o.dir > 0 ? o.bot - bufATR * atr : o.top + bufATR * atr
                rk = math.abs(close - sp)
                if rk > 0
                    eStop    := sp
                    eBE      := close
                    eTp1     := close + o.dir * tp1R * rk
                    eTp2     := close + o.dir * tp2R * rk
                    eDir     := o.dir
                    tp1Done  := false
                    entryBar := bar_index
                    o.used   := true
                    tradesToday += 1
                    newSignal := true

                    qty = sizeMode == "Lot fixe" ? fixQty
                         : math.max(fixQty, strategy.equity * riskPct / 100.0 / rk)
                    if o.dir > 0
                        strategy.entry("L", strategy.long, qty = qty)
                    else
                        strategy.entry("S", strategy.short, qty = qty)

// ------------------------------------------------------------- GESTION ---
// Les ordres de sortie sont (re)poses a CHAQUE bougie tant qu'une position
// est ouverte OU vient d'etre declenchee sur cette bougie.
hasPos = strategy.position_size != 0 or newSignal

if hasPos and not na(eStop) and eDir != 0
    eid = eDir > 0 ? "L" : "S"

    // TP1 partiel : ferme part1 % au premier objectif
    if not tp1Done and part1 < 100
        strategy.exit("TP1", from_entry = eid, qty_percent = part1,
             limit = eTp1, stop = eStop)

    // Reste de la position : stop + TP2
    strategy.exit("TP2", from_entry = eid, limit = eTp2, stop = eStop)

    // Detection du passage au TP1 -> stop a l'equilibre
    if not tp1Done and not newSignal
        hit1 = eDir > 0 ? high >= eTp1 : low <= eTp1
        if hit1
            tp1Done := true
            if beAfter
                eStop := eBE

    // Sortie au temps, comme dans le backtest Python
    if not na(entryBar) and bar_index - entryBar >= maxHold
        strategy.close_all("duree max")
        eDir := 0

if strategy.position_size == 0 and strategy.opentrades == 0 and not newSignal
    eDir := 0

// -------------------------------------------------------------- REPERES ---
plotshape(newSignal and eDir > 0, "Achat", shape.triangleup, location.belowbar,
     #089981, size = size.tiny)
plotshape(newSignal and eDir < 0, "Vente", shape.triangledown, location.abovebar,
     #f23645, size = size.tiny)

// --- compteur de diagnostic : si le Strategy Tester affiche 0 trade, ce
// --- tableau dit ou le filtre bloque.
var int nImp  = 0
var int nZone = 0
var int nSig  = 0
if barstate.isconfirmed
    if impulse
        nImp += 1
    if array.size(obs) > 0
        nZone += 1
    if newSignal
        nSig += 1

var table dbg = na
if barstate.islast
    table.delete(dbg)
    dbg := table.new(position.top_right, 2, 6, bgcolor = color.new(#131722, 10),
         border_width = 1, border_color = color.new(color.gray, 70))
    table.cell(dbg, 0, 0, "DIAGNOSTIC", text_color = #2962ff, text_size = size.small)
    table.cell(dbg, 1, 0, "", text_size = size.small)
    table.cell(dbg, 0, 1, "Impulsions", text_color = color.silver, text_size = size.tiny)
    table.cell(dbg, 1, 1, str.tostring(nImp), text_color = color.white, text_size = size.tiny)
    table.cell(dbg, 0, 2, "Bougies avec zone", text_color = color.silver, text_size = size.tiny)
    table.cell(dbg, 1, 2, str.tostring(nZone), text_color = color.white, text_size = size.tiny)
    table.cell(dbg, 0, 3, "Signaux", text_color = color.silver, text_size = size.tiny)
    table.cell(dbg, 1, 3, str.tostring(nSig), text_color = color.yellow, text_size = size.tiny)
    table.cell(dbg, 0, 4, "Zones actives", text_color = color.silver, text_size = size.tiny)
    table.cell(dbg, 1, 4, str.tostring(array.size(obs)), text_color = color.white, text_size = size.tiny)
    table.cell(dbg, 0, 5, "Tendance H1 / force", text_color = color.silver, text_size = size.tiny)
    table.cell(dbg, 1, 5, str.tostring(htfDir) + " / " + str.tostring(htfForce, "#.00"),
         text_color = color.white, text_size = size.tiny)
