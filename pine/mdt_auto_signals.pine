//@version=6
// MDT-like Auto Signals v3 : UT Bot MTF + zones SMC (Order Blocks, FVG, OTE) + BE precoce + panneau + stats nettes
// - Signaux ACHAT/VENTE avec SL / TP1 / TP2, break-even reglable (avant le TP1)
// - Zones : OB (avec etoiles), FVG, OTE (retracement 0.62-0.79 de la derniere jambe)
// - Stats simulees sur l'historique charge, nettes de frais. Non-repainting (bougies cloturees).
indicator("MDT-like Auto Signals v3", shorttitle = "MDT Auto", overlay = true, max_labels_count = 500, max_boxes_count = 300)

// ---------- Inputs ----------
g1 = "UT Bot"
sens    = input.float(2.0, "Sensibilite (Key Value)", minval = 0.5, step = 0.1, group = g1)
atrLen  = input.int(10, "ATR periode", minval = 1, group = g1)
g2 = "Scanner MTF"
tf1     = input.timeframe("5",   "UT 1", group = g2)
tf2     = input.timeframe("15",  "UT 2", group = g2)
tf3     = input.timeframe("60",  "UT 3", group = g2)
tf4     = input.timeframe("240", "UT 4", group = g2)
minVote = input.int(0, "Votes minimum pour signaler (0 = aucun filtre)", minval = 0, maxval = 4, group = g2)
g3 = "Filtres (optionnels)"
useEma  = input.bool(false, "Filtre EMA", group = g3)
emaLen  = input.int(200, "EMA", group = g3)
useAdx  = input.bool(false, "Filtre ADX", group = g3)
adxMin  = input.float(20.0, "ADX min", group = g3)
reqZone = input.bool(false, "Signal seulement si le prix est dans une zone (OB / FVG / OTE)", group = g3)
g4 = "Trade"
slMult  = input.float(2.0, "SL = x ATR", step = 0.1, group = g4)
beR     = input.float(0.3, "Break-even : SL a l'entree des X R (0 = seulement apres TP1)", step = 0.1, minval = 0, group = g4)
beOff   = input.float(0.05, "Marge du BE (en R, couvre les frais)", step = 0.01, minval = 0, group = g4)
tp1R    = input.float(0.5, "TP1 (R)", step = 0.1, group = g4)
tp1Pct  = input.float(50.0, "% ferme au TP1 (le reste passe a BE)", minval = 0, maxval = 100, group = g4)
tp2R    = input.float(3.0, "TP2 (R)", step = 0.1, group = g4)
costPct = input.float(0.005, "Frais par cote (%) - or ~0.005, crypto ~0.05", step = 0.001, group = g4)
showPanel = input.bool(true, "Afficher le panneau", group = g4)
g5 = "Zones SMC"
showOb  = input.bool(true, "Order Blocks", group = g5)
showFvg = input.bool(true, "FVG", group = g5)
showOte = input.bool(true, "OTE (zone d'entree optimale)", group = g5)
swingLen = input.int(5, "Longueur swing (pivots)", minval = 2, group = g5)
maxZ    = input.int(4, "Zones max par type", minval = 1, maxval = 15, group = g5)
fvgMin  = input.float(0.3, "FVG min (x ATR)", step = 0.1, group = g5)
oteA    = input.float(0.62, "OTE debut (fib)", step = 0.01, group = g5)
oteB    = input.float(0.79, "OTE fin (fib)", step = 0.01, group = g5)
maxZoneATR = input.float(3.0, "Taille max d'un OB (x ATR)", step = 0.5, group = g5)
g6 = "Confluence MTF des OB"
htfA    = input.timeframe("15",  "OB TF 1", group = g6)
htfB    = input.timeframe("60",  "OB TF 2", group = g6)
htfC    = input.timeframe("240", "OB TF 3", group = g6)
showHtf = input.bool(true, "Dessiner le dernier OB de chaque TF superieur (cadre pointille)", group = g6)
onlyConf = input.bool(false, "Cacher les OB sans confluence", group = g6)

// ---------- UT Bot ----------
f_ut(float a, int len) =>
    float src   = close
    float nLoss = a * ta.atr(len)
    var float ts = 0.0
    float p = nz(ts[1], src)
    if src > p and src[1] > p
        ts := math.max(p, src - nLoss)
    else if src < p and src[1] < p
        ts := math.min(p, src + nLoss)
    else
        ts := src > p ? src - nLoss : src + nLoss
    int dir = src > ts ? 1 : -1
    [ts, dir]

f_utDir() =>
    [t, d] = f_ut(sens, atrLen)
    d

f_mtf(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_utDir()[1], lookahead = barmerge.lookahead_on)

[ts, dir] = f_ut(sens, atrLen)
d1 = f_mtf(tf1)
d2 = f_mtf(tf2)
d3 = f_mtf(tf3)
d4 = f_mtf(tf4)
votesL = (d1 == 1 ? 1 : 0) + (d2 == 1 ? 1 : 0) + (d3 == 1 ? 1 : 0) + (d4 == 1 ? 1 : 0)
votesS = (d1 == -1 ? 1 : 0) + (d2 == -1 ? 1 : 0) + (d3 == -1 ? 1 : 0) + (d4 == -1 ? 1 : 0)

atr    = ta.atr(atrLen)
ema    = ta.ema(close, emaLen)
[_p, _m, adx] = ta.dmi(14, 14)

// ---------- Zones SMC : OB / FVG / OTE ----------
var array<box> bullOb  = array.new<box>()
var array<box> bearOb  = array.new<box>()
var array<box> bullFvg = array.new<box>()
var array<box> bearFvg = array.new<box>()
var array<string> bullObT  = array.new<string>()
var array<string> bearObT  = array.new<string>()
var array<string> bullFvgT = array.new<string>()
var array<string> bearFvgT = array.new<string>()
var box oteL = na
var box oteS = na
var float oteLOrigin = na
var float oteSOrigin = na
var int lastBullFvg = -1
var int lastBearFvg = -1

f_add(array<box> arr, array<string> tarr, int left, float top, float bot, color c, string txt) =>
    box b = box.new(left, top, bar_index, bot, border_color = color.new(c, 40), bgcolor = color.new(c, 85),
         extend = extend.right, text = txt, text_size = size.tiny, text_color = color.new(c, 0),
         text_halign = text.align_right)
    array.push(arr, b)
    array.push(tarr, txt)
    if array.size(arr) > maxZ
        box.delete(array.shift(arr))
        array.shift(tarr)

f_mit(array<box> arr, array<string> tarr, bool bull) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            box b = array.get(arr, i)
            if bull ? close < box.get_bottom(b) : close > box.get_top(b)
                box.set_extend(b, extend.none)
                box.set_right(b, bar_index)
                array.remove(arr, i)
                array.remove(tarr, i)

f_in(array<box> arr, float px) =>
    bool r = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            box b = array.get(arr, i)
            if px <= box.get_top(b) and px >= box.get_bottom(b)
                r := true
    r

// --- OB des timeframes superieurs (dernier OB non mitige de chaque cote) ---
f_htfOb(int len) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    var float hiL = na
    var int   hiB = na
    var bool  hiD = true
    var float loL = na
    var int   loB = na
    var bool  loD = true
    var float bT = na
    var float bB = na
    var float sT = na
    var float sB = na
    if not na(ph)
        hiL := ph
        hiB := bar_index - len
        hiD := false
    if not na(pl)
        loL := pl
        loB := bar_index - len
        loD := false
    if not na(hiL) and not hiD and close > hiL
        hiD := true
        int n = math.min(bar_index - hiB, 400)
        float mn = low
        int off = 0
        for i = 0 to n
            if low[i] < mn
                mn := low[i]
                off := i
        bT := high[off]
        bB := low[off]
    if not na(loL) and not loD and close < loL
        loD := true
        int n2 = math.min(bar_index - loB, 400)
        float mx = high
        int off2 = 0
        for i = 0 to n2
            if high[i] > mx
                mx := high[i]
                off2 := i
        sT := high[off2]
        sB := low[off2]
    if not na(bB) and close < bB
        bT := na
        bB := na
    if not na(sT) and close > sT
        sT := na
        sB := na
    [bT, bB, sT, sB]

f_h(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_htfOb(swingLen), lookahead = barmerge.lookahead_off)

f_tfName(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec < 3600 ? "M" + str.tostring(int(sec / 60)) : sec < 86400 ? "H" + str.tostring(int(sec / 3600)) : "D"

[a1, a2, a3, a4] = f_h(htfA)
[b1, b2, b3, b4] = f_h(htfB)
[c1, c2, c3, c4] = f_h(htfC)
bool okA = timeframe.in_seconds() < timeframe.in_seconds(htfA)
bool okB = timeframe.in_seconds() < timeframe.in_seconds(htfB)
bool okC = timeframe.in_seconds() < timeframe.in_seconds(htfC)

var array<float> hbT = array.new<float>(3, na)
var array<float> hbB = array.new<float>(3, na)
var array<float> hsT = array.new<float>(3, na)
var array<float> hsB = array.new<float>(3, na)
array.set(hbT, 0, okA ? a1 : na)
array.set(hbB, 0, okA ? a2 : na)
array.set(hsT, 0, okA ? a3 : na)
array.set(hsB, 0, okA ? a4 : na)
array.set(hbT, 1, okB ? b1 : na)
array.set(hbB, 1, okB ? b2 : na)
array.set(hsT, 1, okB ? b3 : na)
array.set(hsB, 1, okB ? b4 : na)
array.set(hbT, 2, okC ? c1 : na)
array.set(hbB, 2, okC ? c2 : na)
array.set(hsT, 2, okC ? c3 : na)
array.set(hsB, 2, okC ? c4 : na)
array<string> hNames = array.from(f_tfName(htfA), f_tfName(htfB), f_tfName(htfC))

// timeframes superieurs qui se recoupent avec la zone [bot, top]
f_conf(float top, float bot, bool bull) =>
    string r = ""
    for i = 0 to 2
        float ht = na
        float hb = na
        if bull
            ht := array.get(hbT, i)
            hb := array.get(hbB, i)
        else
            ht := array.get(hsT, i)
            hb := array.get(hsB, i)
        if not na(ht) and top >= hb and bot <= ht
            r += (r == "" ? "" : "+") + array.get(hNames, i)
    r

var array<box> hBoxB = array.new<box>(3, na)
var array<box> hBoxS = array.new<box>(3, na)
f_hz(array<box> arr, int i, float top, float bot, string name, color c) =>
    box cur = array.get(arr, i)
    if na(top) or not showHtf
        if not na(cur)
            box.delete(cur)
            array.set(arr, i, na)
    else
        if na(cur) or box.get_top(cur) != top or box.get_bottom(cur) != bot
            if not na(cur)
                box.delete(cur)
            array.set(arr, i, box.new(bar_index, top, bar_index, bot, border_color = c, border_width = 2,
                 border_style = line.style_dashed, bgcolor = color.new(c, 100), extend = extend.right,
                 text = name, text_size = size.small, text_color = c, text_halign = text.align_left))

f_refresh(array<box> arr, array<string> tarr, bool bull) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            box b = array.get(arr, i)
            string cf = f_conf(box.get_top(b), box.get_bottom(b), bull)
            string base = array.get(tarr, i)
            color c = bull ? color.green : color.red
            if cf == ""
                box.set_text(b, base)
                box.set_text_color(b, onlyConf ? color.new(c, 100) : color.new(c, 0))
                box.set_border_color(b, onlyConf ? color.new(c, 100) : color.new(c, 40))
                box.set_bgcolor(b, onlyConf ? color.new(c, 100) : color.new(c, 85))
                box.set_border_width(b, 1)
            else
                box.set_text(b, base + " ⚡" + cf)
                box.set_text_color(b, color.yellow)
                box.set_border_color(b, color.yellow)
                box.set_bgcolor(b, color.new(c, 70))
                box.set_border_width(b, 2)

float piH = ta.pivothigh(high, swingLen, swingLen)
float piL = ta.pivotlow(low, swingLen, swingLen)
var float hiLvl = na
var int   hiBar = na
var bool  hiDone = true
var float loLvl = na
var int   loBar = na
var bool  loDone = true

if not na(piH)
    hiLvl := piH
    hiBar := bar_index - swingLen
    hiDone := false
if not na(piL)
    loLvl := piL
    loBar := bar_index - swingLen
    loDone := false

// FVG
bool bullGap = low > high[2] and close[1] > high[2] and (low - high[2]) > atr * fvgMin
bool bearGap = high < low[2] and close[1] < low[2] and (low[2] - high) > atr * fvgMin
if bullGap
    lastBullFvg := bar_index
    if showFvg
        f_add(bullFvg, bullFvgT, bar_index - 2, low, high[2], color.aqua, "FVG+")
if bearGap
    lastBearFvg := bar_index
    if showFvg
        f_add(bearFvg, bearFvgT, bar_index - 2, low[2], high, color.fuchsia, "FVG-")

// BOS haussier -> OB acheteur + OTE acheteur
if not na(hiLvl) and not hiDone and close > hiLvl
    hiDone := true
    int n = math.min(bar_index - hiBar, 400)
    float mn = low
    int off = 0
    for i = 0 to n
        if low[i] < mn
            mn := low[i]
            off := i
    float hh = high
    for i = 0 to off
        hh := math.max(hh, high[i])
    if showOb and (high[off] - low[off]) <= maxZoneATR * atr
        int stars = 1 + (lastBullFvg >= bar_index - off ? 1 : 0) + (d4 == 1 ? 1 : 0)
        f_add(bullOb, bullObT, bar_index - off, high[off], low[off], color.green, "OB+ " + str.repeat("★", stars))
    if showOte
        if not na(oteL)
            box.delete(oteL)
        float rg = hh - mn
        oteL := box.new(bar_index, hh - oteA * rg, bar_index, hh - oteB * rg, border_color = color.new(color.yellow, 30),
             bgcolor = color.new(color.yellow, 88), extend = extend.right, text = "OTE+", text_size = size.tiny,
             text_color = color.yellow, text_halign = text.align_right)
        oteLOrigin := mn

// BOS baissier -> OB vendeur + OTE vendeur
if not na(loLvl) and not loDone and close < loLvl
    loDone := true
    int n2 = math.min(bar_index - loBar, 400)
    float mx = high
    int off2 = 0
    for i = 0 to n2
        if high[i] > mx
            mx := high[i]
            off2 := i
    float ll = low
    for i = 0 to off2
        ll := math.min(ll, low[i])
    if showOb and (high[off2] - low[off2]) <= maxZoneATR * atr
        int stars2 = 1 + (lastBearFvg >= bar_index - off2 ? 1 : 0) + (d4 == -1 ? 1 : 0)
        f_add(bearOb, bearObT, bar_index - off2, high[off2], low[off2], color.red, "OB- " + str.repeat("★", stars2))
    if showOte
        if not na(oteS)
            box.delete(oteS)
        float rg2 = mx - ll
        oteS := box.new(bar_index, ll + oteB * rg2, bar_index, ll + oteA * rg2, border_color = color.new(color.orange, 30),
             bgcolor = color.new(color.orange, 88), extend = extend.right, text = "OTE-", text_size = size.tiny,
             text_color = color.orange, text_halign = text.align_right)
        oteSOrigin := mx

f_mit(bullOb, bullObT, true)
f_mit(bearOb, bearObT, false)
f_mit(bullFvg, bullFvgT, true)
f_mit(bearFvg, bearFvgT, false)
f_refresh(bullOb, bullObT, true)
f_refresh(bearOb, bearObT, false)
f_hz(hBoxB, 0, array.get(hbT, 0), array.get(hbB, 0), array.get(hNames, 0) + " OB+", color.blue)
f_hz(hBoxS, 0, array.get(hsT, 0), array.get(hsB, 0), array.get(hNames, 0) + " OB-", color.blue)
f_hz(hBoxB, 1, array.get(hbT, 1), array.get(hbB, 1), array.get(hNames, 1) + " OB+", color.purple)
f_hz(hBoxS, 1, array.get(hsT, 1), array.get(hsB, 1), array.get(hNames, 1) + " OB-", color.purple)
f_hz(hBoxB, 2, array.get(hbT, 2), array.get(hbB, 2), array.get(hNames, 2) + " OB+", color.white)
f_hz(hBoxS, 2, array.get(hsT, 2), array.get(hsB, 2), array.get(hNames, 2) + " OB-", color.white)
if not na(oteL) and close < oteLOrigin
    box.set_extend(oteL, extend.none)
    box.set_right(oteL, bar_index)
    oteL := na
if not na(oteS) and close > oteSOrigin
    box.set_extend(oteS, extend.none)
    box.set_right(oteS, bar_index)
    oteS := na

bool inLong  = f_in(bullOb, close) or f_in(bullFvg, close) or (not na(oteL) and close <= box.get_top(oteL) and close >= box.get_bottom(oteL))
bool inShort = f_in(bearOb, close) or f_in(bearFvg, close) or (not na(oteS) and close <= box.get_top(oteS) and close >= box.get_bottom(oteS))

// ---------- Signaux ----------
okF = (not useAdx or adx > adxMin)
buyRaw  = dir == 1  and dir[1] == -1
sellRaw = dir == -1 and dir[1] == 1
longSig  = buyRaw  and votesL >= minVote and okF and (not useEma or close > ema) and (not reqZone or inLong)
shortSig = sellRaw and votesS >= minVote and okF and (not useEma or close < ema) and (not reqZone or inShort)

f_sess() =>
    int h = hour(time, "UTC")
    h < 7 ? 2 : h < 13 ? 0 : h < 21 ? 1 : 3   // 0 LON, 1 NY, 2 ASIE, 3 HORS

// ---------- Simulation du trade (un seul a la fois) ----------
var int   pos = 0
var int   entBar = 0
var float ent = na
var float riskD = na
var float slCur = na
var float tp1 = na
var float tp2 = na
var bool  tp1Hit = false
var bool  moved = false
var float banked = 0.0
var float maxFav = 0.0
var int   sess = 0
var label lbl = na
var int   nTot = 0
var int   nWin = 0
var int   nTp1 = 0
var int   nTp2 = 0
var int   nBe = 0
var float sumR = 0.0
var float sumR2 = 0.0
var array<int> sessN = array.from(0, 0, 0, 0)
var array<int> sessW = array.from(0, 0, 0, 0)

bool conf = barstate.isconfirmed
bool closedNow = false
bool hitTp2 = false
float resR = na
float rest = 1.0 - tp1Pct / 100.0

if conf and pos != 0 and bar_index > entBar
    bool slHit = pos == 1 ? low <= slCur : high >= slCur
    if slHit
        closedNow := true
        resR := (tp1Hit ? banked : 0.0) + (tp1Hit ? rest : 1.0) * (moved ? beOff : -1.0)
    else
        float fav = (pos == 1 ? high - ent : ent - low) / riskD
        maxFav := math.max(maxFav, fav)
        if not moved and beR > 0 and fav >= beR
            moved := true
            slCur := ent + pos * beOff * riskD
        if not tp1Hit and (pos == 1 ? high >= tp1 : low <= tp1)
            tp1Hit := true
            moved := true
            banked := tp1Pct / 100.0 * tp1R
            slCur := ent + pos * beOff * riskD
        if pos == 1 ? high >= tp2 : low <= tp2
            closedNow := true
            hitTp2 := true
            resR := (tp1Hit ? banked : 0.0) + (tp1Hit ? rest : 1.0) * tp2R

if conf and pos != 0 and not closedNow and ((pos == 1 and sellRaw) or (pos == -1 and buyRaw))
    float rr = (close - ent) * pos / riskD
    resR := tp1Hit ? banked + rest * rr : rr
    closedNow := true

if closedNow
    float net = resR - 2.0 * costPct / 100.0 * ent / riskD
    nTot += 1
    sumR += net
    sumR2 += net * net
    if net > 0
        nWin += 1
    if tp1Hit
        nTp1 += 1
    if hitTp2
        nTp2 += 1
    if moved and not tp1Hit and not hitTp2
        nBe += 1
    array.set(sessN, sess, array.get(sessN, sess) + 1)
    if net > 0
        array.set(sessW, sess, array.get(sessW, sess) + 1)
    label.set_text(lbl, (pos == 1 ? "ACHAT " : "VENTE ") + str.tostring(ent, format.mintick) + " | "
         + (net >= 0 ? "+" : "") + str.tostring(net, "#.00") + "R " + (net > 0 ? "✓" : "✗"))
    pos := 0

if conf and pos == 0 and (longSig or shortSig)
    pos := longSig ? 1 : -1
    ent := close
    riskD := atr * slMult
    slCur := ent - pos * riskD
    tp1 := ent + pos * riskD * tp1R
    tp2 := ent + pos * riskD * tp2R
    tp1Hit := false
    moved := false
    banked := 0.0
    maxFav := 0.0
    entBar := bar_index
    sess := f_sess()
    lbl := label.new(bar_index, pos == 1 ? low : high,
         (pos == 1 ? "ACHAT " : "VENTE ") + str.tostring(ent, format.mintick),
         style = pos == 1 ? label.style_label_up : label.style_label_down,
         color = pos == 1 ? color.new(color.green, 0) : color.new(color.red, 0),
         textcolor = color.white, size = size.small)

// ---------- Plots ----------
plot(ts, "UT trailing stop", color = dir == 1 ? color.teal : color.red, linewidth = 2)
plot(pos != 0 ? slCur : na, "SL / BE", color.new(color.orange, 10), style = plot.style_linebr)
plot(pos != 0 ? tp1 : na, "TP1", color.new(color.lime, 30), style = plot.style_linebr)
plot(pos != 0 ? tp2 : na, "TP2", color.new(color.green, 30), style = plot.style_linebr)
bgcolor(pos == 1 ? color.new(color.green, 94) : pos == -1 ? color.new(color.red, 94) : na)

alertcondition(longSig,  "MDT ACHAT", "Signal ACHAT {{ticker}} {{interval}}")
alertcondition(shortSig, "MDT VENTE", "Signal VENTE {{ticker}} {{interval}}")

// ---------- Panneau ----------
var table t = table.new(position.top_right, 2, 27, bgcolor = color.new(color.black, 15), border_width = 1,
     border_color = color.new(color.gray, 70), frame_width = 1, frame_color = color.new(color.gray, 40))

f_row(int r, string a, string b, color c = color.white) =>
    table.cell(t, 0, r, a, text_color = color.new(color.white, 25), text_halign = text.align_left, text_size = size.small)
    table.cell(t, 1, r, b, text_color = c, text_halign = text.align_right, text_size = size.small)

f_head(int r, string a) =>
    table.cell(t, 0, r, a, text_color = color.aqua, bgcolor = color.new(color.blue, 80), text_halign = text.align_left, text_size = size.small)
    table.cell(t, 1, r, "", bgcolor = color.new(color.blue, 80))

f_dir(int d) => d == 1 ? "HAUSSE" : "BAISSE"
f_col(int d) => d == 1 ? color.lime : color.red

f_pct(int a, int b) => b > 0 ? str.tostring(a) + " (" + str.tostring(100.0 * a / b, "#.0") + "%)" : "-"

if barstate.islast and showPanel
    f_head(0, "◆ MDT · AUTO SIGNALS")
    f_head(1, "◇ SCANNER MTF")
    f_row(2, "UT " + tf1, f_dir(d1), f_col(d1))
    f_row(3, "UT " + tf2, f_dir(d2), f_col(d2))
    f_row(4, "UT " + tf3, f_dir(d3), f_col(d3))
    f_row(5, "UT " + tf4, f_dir(d4), f_col(d4))
    string cons = votesL >= 3 ? "HAUSSIER" : votesS >= 3 ? "BAISSIER" : "MIXTE"
    f_row(6, "Consensus", cons, votesL >= 3 ? color.lime : votesS >= 3 ? color.red : color.gray)
    f_head(7, "◈ TRADE EN COURS")
    if pos != 0
        float curR = (close - ent) * pos / riskD
        f_row(8,  "Entrée", str.tostring(ent, format.mintick))
        f_row(9,  "SL", str.tostring(slCur, format.mintick), color.orange)
        f_row(10, "TP1 " + str.tostring(tp1R, "#.0#") + "R", str.tostring(tp1, format.mintick), color.lime)
        f_row(11, "TP2 " + str.tostring(tp2R, "#.0#") + "R", str.tostring(tp2, format.mintick), color.lime)
        f_row(12, "Statut", tp1Hit ? "TP1 ✓ · BE" : moved ? "BE ✓" : "⏳ EN COURS")
        f_row(13, "PnL", (curR >= 0 ? "+" : "") + str.tostring(curR, "#.00") + "R", curR >= 0 ? color.lime : color.red)
        f_row(14, "Max", "+" + str.tostring(maxFav, "#.00") + "R")
    else
        f_row(8,  "Entrée", "-")
        f_row(9,  "SL", "-")
        f_row(10, "TP1", "-")
        f_row(11, "TP2", "-")
        f_row(12, "Statut", "✓ PRÊT", color.yellow)
        f_row(13, "PnL", "-")
        f_row(14, "Max", "-")
    f_head(15, "◆ STATS GLOBALES (frais inclus)")
    float meanR = nTot > 0 ? sumR / nTot : na
    float seR = nTot > 1 ? math.sqrt(math.max(sumR2 / nTot - meanR * meanR, 0.0) / nTot) : na
    float lo95 = meanR - 1.96 * seR
    float hi95 = meanR + 1.96 * seR
    f_row(16, "Total / gagnants (BE inclus)", f_pct(nWin, nTot))
    f_row(17, "R moyen net", nTot > 0 ? (meanR >= 0 ? "+" : "") + str.tostring(meanR, "#.000") + "R" : "-",
         nTot > 0 and meanR > 0 ? color.lime : color.red)
    f_row(18, "IC 95% du R moyen", nTot > 1 ? "[" + str.tostring(lo95, "#.00") + " ; " + str.tostring(hi95, "#.00") + "]" : "-",
         nTot > 1 ? (lo95 > 0 ? color.lime : hi95 < 0 ? color.red : color.gray) : color.gray)
    f_row(19, "R cumulé", nTot > 0 ? (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.0") + "R" : "-")
    f_row(20, "TP1 touché", f_pct(nTp1, nTot))
    f_row(21, "TP2 touché", f_pct(nTp2, nTot))
    f_row(22, "Sortis à BE", f_pct(nBe, nTot))
    f_head(23, "◐ SESSIONS (gagnants)")
    f_row(24, "LON / NY", f_pct(array.get(sessW, 0), array.get(sessN, 0)) + " / " + f_pct(array.get(sessW, 1), array.get(sessN, 1)))
    f_row(25, "ASIE / HORS", f_pct(array.get(sessW, 2), array.get(sessN, 2)) + " / " + f_pct(array.get(sessW, 3), array.get(sessN, 3)))
