//@version=6
// SMC : Order Blocks + Fair Value Gaps + score de confluence + tableau MTF (equivalent du 2e indicateur)
// OB = bougie extreme entre le swing casse et la cassure (BOS). FVG = gap a 3 bougies.
// Confluence (etoiles) : 1 de base, +1 si un FVG de meme sens s'est forme dans l'impulsion, +1 si H4 est aligne.
indicator("SMC OB + FVG + MTF", overlay = true, max_boxes_count = 300, max_labels_count = 200)

swingLen = input.int(5, "Longueur swing (pivots)", minval = 2)
maxZones = input.int(5, "Zones max par type", minval = 1, maxval = 20)
fvgMin   = input.float(0.3, "FVG min (x ATR)", step = 0.1)
showFvg  = input.bool(true, "Afficher FVG")
showOb   = input.bool(true, "Afficher OB")
tfs = array.from("5", "15", "60", "240", "D")

// ---------- Moteur structure / OB ----------
f_smc(int len) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    var float hiLvl = na
    var int hiBar = na
    var bool hiDone = true
    var float loLvl = na
    var int loBar = na
    var bool loDone = true
    var int trend = 0
    var float bTop = na
    var float bBot = na
    var int bBar = na
    var float sTop = na
    var float sBot = na
    var int sBar = na
    bool newB = false
    bool newS = false
    if not na(ph)
        hiLvl := ph
        hiBar := bar_index - len
        hiDone := false
    if not na(pl)
        loLvl := pl
        loBar := bar_index - len
        loDone := false
    if not na(hiLvl) and not hiDone and close > hiLvl
        hiDone := true
        trend := 1
        int n = math.min(bar_index - hiBar, 400)
        float mn = low
        int off = 0
        for i = 0 to n
            if low[i] < mn
                mn := low[i]
                off := i
        bTop := high[off]
        bBot := low[off]
        bBar := bar_index - off
        newB := true
    if not na(loLvl) and not loDone and close < loLvl
        loDone := true
        trend := -1
        int n = math.min(bar_index - loBar, 400)
        float mx = high
        int off = 0
        for i = 0 to n
            if high[i] > mx
                mx := high[i]
                off := i
        sTop := high[off]
        sBot := low[off]
        sBar := bar_index - off
        newS := true
    // mitigation : cloture au-dela de la zone
    if not na(bBot) and close < bBot
        bTop := na
        bBot := na
    if not na(sTop) and close > sTop
        sTop := na
        sBot := na
    [trend, bTop, bBot, sTop, sBot, newB, newS, bBar, sBar]

f_lite() =>
    [tr, bT, bB, sT, sB, nb, ns, bb, sb] = f_smc(swingLen)
    [tr, bT, bB, sT, sB]

f_htf(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_lite(), lookahead = barmerge.lookahead_off)

// ---------- Chart TF ----------
[trend, bT, bB, sT, sB, newB, newS, bBr, sBr] = f_smc(swingLen)
[hTr, hbT, hbB, hsT, hsB] = f_htf("240")
atr = ta.atr(14)

var int lastBullFvg = -1
var int lastBearFvg = -1
var array<box> bullOb = array.new<box>()
var array<box> bearOb = array.new<box>()
var array<box> bullFvg = array.new<box>()
var array<box> bearFvg = array.new<box>()

f_add(array<box> arr, int left, float top, float bot, color c, string txt) =>
    box b = box.new(left, top, bar_index, bot, border_color = color.new(c, 40), bgcolor = color.new(c, 85),
         extend = extend.right, text = txt, text_size = size.tiny, text_color = color.new(c, 0),
         text_halign = text.align_right)
    array.push(arr, b)
    if array.size(arr) > maxZones
        box.delete(array.shift(arr))

f_mitigate(array<box> arr, bool bull) =>
    for i = array.size(arr) - 1 to 0 by 1
        box b = array.get(arr, i)
        if bull ? close < box.get_bottom(b) : close > box.get_top(b)
            box.set_extend(b, extend.none)
            box.set_right(b, bar_index)
            array.remove(arr, i)

// FVG
bullGap = low > high[2] and close[1] > high[2] and (low - high[2]) > atr * fvgMin
bearGap = high < low[2] and close[1] < low[2] and (low[2] - high) > atr * fvgMin
if bullGap
    lastBullFvg := bar_index
    if showFvg
        f_add(bullFvg, bar_index - 2, low, high[2], color.teal, "FVG+")
if bearGap
    lastBearFvg := bar_index
    if showFvg
        f_add(bearFvg, bar_index - 2, low[2], high, color.red, "FVG-")

// OB + score
f_stars(int s) =>
    str.repeat("★", s)

if newB and showOb
    int sc = 1 + (lastBullFvg >= bBr ? 1 : 0) + (hTr == 1 ? 1 : 0)
    f_add(bullOb, bBr, bT, bB, color.green, "OB+ " + f_stars(sc))
if newS and showOb
    int sc = 1 + (lastBearFvg >= sBr ? 1 : 0) + (hTr == -1 ? 1 : 0)
    f_add(bearOb, sBr, sT, sB, color.maroon, "OB- " + f_stars(sc))

f_mitigate(bullOb, true)
f_mitigate(bearOb, false)
f_mitigate(bullFvg, true)
f_mitigate(bearFvg, false)

// ---------- Tableau MTF ----------
[t1, bt1, bb1, st1, sb1] = f_htf("5")
[t2, bt2, bb2, st2, sb2] = f_htf("15")
[t3, bt3, bb3, st3, sb3] = f_htf("60")
[t4, bt4, bb4, st4, sb4] = f_htf("240")
[t5, bt5, bb5, st5, sb5] = f_htf("D")

var table tbl = table.new(position.bottom_right, 4, 6, bgcolor = color.new(color.black, 25), border_width = 1)
f_row(int r, string name, int tr, float bt, float bb, float st, float sb) =>
    table.cell(tbl, 0, r, name, text_color = color.white)
    table.cell(tbl, 1, r, tr == 1 ? "Haussier" : tr == -1 ? "Baissier" : "-", text_color = tr == 1 ? color.lime : tr == -1 ? color.red : color.gray)
    table.cell(tbl, 2, r, na(bt) ? "-" : str.tostring(bb, format.mintick) + " / " + str.tostring(bt, format.mintick), text_color = color.lime)
    table.cell(tbl, 3, r, na(st) ? "-" : str.tostring(sb, format.mintick) + " / " + str.tostring(st, format.mintick), text_color = color.red)

if barstate.islast
    table.cell(tbl, 0, 0, "TF", text_color = color.white)
    table.cell(tbl, 1, 0, "Tendance", text_color = color.white)
    table.cell(tbl, 2, 0, "Bull OB", text_color = color.white)
    table.cell(tbl, 3, 0, "Bear OB", text_color = color.white)
    f_row(1, "5",   t1, bt1, bb1, st1, sb1)
    f_row(2, "15",  t2, bt2, bb2, st2, sb2)
    f_row(3, "60",  t3, bt3, bb3, st3, sb3)
    f_row(4, "240", t4, bt4, bb4, st4, sb4)
    f_row(5, "D",   t5, bt5, bb5, st5, sb5)
